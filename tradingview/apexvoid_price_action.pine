//@version=6
indicator("ApexVoid | Price Action v2.9", "AV PA v2.9", overlay = true, scale = scale.none, behind_chart = true, max_bars_back = 800, max_lines_count = 350, max_boxes_count = 250, max_labels_count = 500)

// APEXVOID PRICE ACTION SUITE
// Repository: apexvoid-trading-bot/tradingview/apexvoid_price_action.pine
// All structural events and zone lifecycle changes require a CLOSED chart bar.
// Internal/external swing labels appear after their respective pivot confirmation lag.
// A zone/sweep is an analytical reference, not an automatic entry signal.
// TradingView: Pine Editor -> paste this file -> Save -> Add to chart.
// Suggested starting point: XAUUSD M5/M15; tune sensitivity and filters per symbol.
// v2.9: a planned long/short RR box is always drawn for the nearest qualified POI (preview), trade boxes
// carry only the R:R number.
// v2.8: trade plan - price-action entry at a qualified POI, stop beyond the zone, target at the
// nearest key level, long/short position boxes for the last N trades, paper-tracked results.
// v2.7.1: compile fix (a Pine line cannot be queried for its colour; BOS de-duplication keeps a direction array).
// v2.7: one right-edge label column (labels at the same price merge, never overlap), BOS label
// beside the break candle, one BOS per candle, slim premium/discount gauge.
// v2.6: BOS / CHoCH lines end on the candle that actually closed beyond the swing, not on
// the later bar where the swing was published (up to 38 bars late on XAUUSD M15).
// v2.5: BSL/SSL restored - objects may use the price range the candles already span (so
// they cannot squash the scale), plus the nearest unswept internal swing high/low.
// v2.4: compact "major only" panel, premium / discount range, POI captions name the zone kind.
// v2.3: candle-scale protection (objects limited to a window around price), lighter zone
// fills, shorter drawn lengths, larger and better-spaced labels.
// v2.2: base-and-impulse supply/demand zones (DBR / RBR / RBD / DBD) beside the swing zones.
// v2.1: order blocks restored (swing + internal, own display budget, lifecycle) and
// BSL/SSL rebuilt as a level-first liquidity-pool model (sweep != break). See
// tradingview/docs/ob-liquidity-v2.1.md for definitions and known limitations.

const string G1 = "01  Market Structure"
const string G2 = "02  Liquidity"
const string G3 = "03  Order Blocks & Zones"
const string G4 = "04  Fair Value Gaps"
const string G5 = "05  Asian Session"
const string G6 = "06  Visuals & Performance"
const string G7 = "07  Higher-Timeframe Context"
const string G8 = "08  Trade Plan"

string displayProfile = input.string("Balanced — Recommended", "Display profile", options = ["Balanced — Recommended", "Minimal", "Detailed", "Debug"], group = G6)
string sensitivity = input.string("Auto", "Swing sensitivity", options = ["Auto", "Manual"], group = G1)
int manualInternal = input.int(4, "Manual internal pivot bars", minval = 2, maxval = 25, group = G1)
int manualExternal = input.int(18, "Manual external pivot bars", minval = 5, maxval = 80, group = G1)
float minLegATR = input.float(1.50, "Minimum external leg displacement (ATR)", minval = 0.25, maxval = 5, step = 0.05, group = G1)
float confirmATR = input.float(0.15, "External confirmation threshold (ATR)", minval = 0, maxval = 1, step = 0.01, group = G1)
float breakBuffer = input.float(0.00, "BOS/CHOCH close buffer (ATR)", minval = 0, maxval = 1, step = 0.01, group = G1)
bool showHistoricalMajor = input.bool(false, "Show historical major classifications", group = G1)
bool showMajorLevels = input.bool(true, "Extend current major high / low", group = G1)
bool showInternalSwing = input.bool(false, "Show internal structure", group = G1)
bool showBreaks = input.bool(true, "Draw BOS / CHOCH", group = G1)
int majorEventLimit = input.int(6, "Relevant external BOS/CHoCH history", minval = 2, maxval = 12, group = G1)

bool showLiquidity = input.bool(true, "Show relevant BSL / SSL pools", group = G2)
bool showSweeps = input.bool(true, "Highlight liquidity grabs (rejection wick)", group = G2)
float equalTolerance = input.float(0.15, "EQH / EQL tolerance (ATR)", minval = 0.01, maxval = 1, step = 0.01, group = G2)
int eqMinSeparation = input.int(8, "Minimum bars between independent tests", minval = 2, maxval = 60, group = G2)
float eqMinPullbackATR = input.float(0.50, "Minimum pullback between tests (ATR)", minval = 0, maxval = 3, step = 0.05, group = G2)
float sweepBuffer = input.float(0.01, "Sweep penetration (ATR)", minval = 0, maxval = 0.5, step = 0.01, group = G2)
string sweepRule = input.string("Within N bars", "Sweep return rule", options = ["Within N bars", "Same bar"], group = G2)
int sweepReturnBars = input.int(2, "Sweep return window (bars)", minval = 1, maxval = 10, group = G2)
float liqBreakBuffer = input.float(0.10, "Pool break buffer (ATR)", minval = 0, maxval = 1, step = 0.01, group = G2)
int liqAcceptCloses = input.int(2, "Closes beyond a pool to consume it", minval = 1, maxval = 5, group = G2)
string consumedPolicy = input.string("Fade, then retire", "Consumed pool policy", options = ["Fade, then retire", "Retire immediately", "Keep faded"], group = G2)
int consumedFadeBars = input.int(40, "Consumed pool fade window (bars)", minval = 5, maxval = 400, group = G2)
int maxLiquidity = input.int(24, "Retained liquidity pools", minval = 4, maxval = 60, group = G2)
int visibleLiquidity = input.int(6, "Visible liquidity pools", minval = 1, maxval = 20, group = G2)
float liqDisplayDistanceATR = input.float(30.0, "Maximum visible pool distance (ATR)", minval = 3, maxval = 100, step = 1, group = G2)
int liqMaxAge = input.int(1500, "Pool maximum age (bars)", minval = 100, maxval = 5000, group = G2)
bool showSessionLiquidity = input.bool(false, "Include previous-day high / low pools", group = G2)
float grabMinWickATR = input.float(0.20, "Minimum rejection wick for grab highlight (ATR)", minval = 0, maxval = 2, step = 0.05, group = G2)
int sweepHistoryLimit = input.int(10, "Visible grab highlight history", minval = 1, maxval = 40, group = G2)

bool showOB = input.bool(true, "Show order blocks", group = G3)
bool showInternalOB = input.bool(true, "Include internal-structure order blocks", group = G3)
int obSearchBars = input.int(40, "Origin search window (bars)", minval = 5, maxval = 120, group = G3)
int obLookback = input.int(12, "POI: OB-to-break proximity (bars)", minval = 2, maxval = 50, group = G3)
