string dashboardDensity = input.string("Compact", "Dashboard display size", options = ["Compact", "Standard", "Expanded"], group = G6)
string dashboardPositionInput = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right"], group = G6)
int annotationBarSpacing = input.int(6, "Annotation horizontal spacing (bars)", minval = 2, maxval = 20, group = G6)
float annotationATRSpacing = input.float(0.30, "Annotation vertical spacing (ATR)", minval = 0.10, maxval = 1.0, step = 0.02, group = G6)

bool showHTFContext = input.bool(false, "Show confirmed HTF context", group = G7)
string htfTimeframe = input.timeframe("240", "Higher timeframe", group = G7)
int htfSwingLength = input.int(12, "HTF swing confirmation bars", minval = 3, maxval = 50, group = G7)
bool drawHTFLevels = input.bool(false, "Draw HTF swing levels", group = G7)

bool showTradePlan = input.bool(true, "Show trade plan (long / short position boxes)", group = G8)
bool showTradePreview = input.bool(true, "Show a planned RR box for the nearest qualified POI before it triggers", group = G8)
string tradeZoneKinds = input.string("All qualified POIs", "Entry zones", options = ["All qualified POIs", "Order blocks and supply/demand", "Order blocks only"], group = G8)
string tradeTrigger = input.string("Rejection or engulfing", "Entry trigger candle", options = ["Rejection or engulfing", "Rejection wick", "Engulfing"], group = G8)
int tradeTriggerBars = input.int(2, "Trigger window after the first touch (bars)", minval = 0, maxval = 10, group = G8)
float tradeWickFrac = input.float(0.40, "Rejection wick minimum (share of candle range)", minval = 0.2, maxval = 0.8, step = 0.05, group = G8)
float tradeChaseATR = input.float(0.75, "Maximum entry distance from the zone edge (ATR)", minval = 0.1, maxval = 3, step = 0.05, group = G8)
bool tradeRequirePD = input.bool(true, "Longs only in discount, shorts only in premium", group = G8)
float tradeStopBufferATR = input.float(0.15, "Stop buffer beyond the zone (ATR)", minval = 0, maxval = 1, step = 0.05, group = G8)
float tradeMinStopATR = input.float(0.40, "Minimum stop distance (ATR)", minval = 0.1, maxval = 3, step = 0.05, group = G8)
float tradeMaxStopATR = input.float(3.00, "Maximum stop distance (ATR)", minval = 0.5, maxval = 10, step = 0.25, group = G8)
string tradeTargetMode = input.string("Next key level", "Target selection", options = ["Next key level", "Nearest level with minimum R:R"], group = G8)
float tradeMinRR = input.float(1.5, "Minimum reward : risk to the key level", minval = 1, maxval = 10, step = 0.1, group = G8)
float tradeTargetBufferATR = input.float(0.05, "Take-profit placed this far before the level (ATR)", minval = 0, maxval = 0.5, step = 0.01, group = G8)
float tradeMaxTargetATR = input.float(25.0, "Maximum target distance (ATR)", minval = 2, maxval = 100, step = 1, group = G8)
int tradeTimeoutBars = input.int(96, "Close a trade at market after (bars)", minval = 5, maxval = 780, group = G8)
float tradeCost = input.float(0.0, "Round-turn cost (price units, deducted from every result)", minval = 0, step = 0.01, group = G8)
int tradeHistory = input.int(5, "Trades drawn on the chart (most recent)", minval = 1, maxval = 20, group = G8)
color tradeProfitColor = input.color(#00C7AE, "Target box color", group = G8)
color tradeRiskColor = input.color(#F26B85, "Stop box color", group = G8)

int chartSecs = nz(timeframe.in_seconds(), 900)
int internalLength = sensitivity == "Manual" ? manualInternal : chartSecs <= 300 ? 3 : chartSecs <= 900 ? 4 : chartSecs <= 3600 ? 5 : chartSecs <= 14400 ? 6 : 8
int externalLength = sensitivity == "Manual" ? manualExternal : chartSecs <= 300 ? 12 : chartSecs <= 900 ? 16 : chartSecs <= 3600 ? 20 : chartSecs <= 14400 ? 24 : 30
float atr = ta.atr(14)
// Candle-scale protection: an object may be drawn if it is near price (window in ATR) or
// inside the price range the last `Candle range reference` bars already span, so it can
// never stretch the chart's price scale beyond what the candles themselves need.
float scaleBandHigh = ta.highest(high, scaleLookbackBars)
float scaleBandLow = ta.lowest(low, scaleLookbackBars)
f_scaleOk(float price) =>
    float pad = nz(atr, 0.0)
    not protectCandleScale or math.abs(price - close) <= scaleWindowATR * nz(atr, syminfo.mintick) or (price <= scaleBandHigh + pad and price >= scaleBandLow - pad)
float internalHigh = ta.pivothigh(high, internalLength, internalLength)
float internalLow = ta.pivotlow(low, internalLength, internalLength)
bool newInternalHigh = barstate.isconfirmed and not na(internalHigh)
bool newInternalLow = barstate.isconfirmed and not na(internalLow)
float externalHigh = ta.pivothigh(high, externalLength, externalLength)
float externalLow = ta.pivotlow(low, externalLength, externalLength)
bool newExternalHigh = barstate.isconfirmed and not na(externalHigh)
bool newExternalLow = barstate.isconfirmed and not na(externalLow)
bool minimalMode = displayProfile == "Minimal"
bool balancedMode = displayProfile == "Balanced — Recommended"
bool detailedMode = displayProfile == "Detailed"
bool debugMode = displayProfile == "Debug"
bool showInternal = showInternalSwing and (detailedMode or debugMode)
bool renderLiquidity = showLiquidity and not minimalMode
bool renderSweeps = showSweeps and not minimalMode
int effectiveVisibleZones = minimalMode ? math.min(visibleZones, 4) : balancedMode ? math.min(visibleZones, 8) : detailedMode ? math.max(visibleZones, 12) : math.min(maxZones, 20)
float effZoneDistanceATR = zoneDisplayDistanceATR
float effObDistanceATR = obDisplayDistanceATR
float effLiqDistanceATR = liqDisplayDistanceATR
float effLiqNearestATR = liqDisplayDistanceATR * 2.0
int effectiveVisibleLiquidity = minimalMode ? 0 : balancedMode ? math.min(visibleLiquidity, 8) : detailedMode ? math.max(visibleLiquidity, 12) : maxLiquidity
int effectiveExternalEvents = minimalMode ? math.min(majorEventLimit, 3) : balancedMode ? math.min(majorEventLimit, 6) : majorEventLimit
int effectiveAsiaHistory = minimalMode ? 1 : asiaHistory
bool compactText = textScaleInput == "Compact"
bool largeText = textScaleInput == "Large"
string majorTextSize = compactText ? size.small : largeText ? size.large : size.normal
string structureTextSize = compactText ? size.small : largeText ? size.large : size.normal
string zoneTextSize = compactText ? size.small : largeText ? size.large : size.normal
string contextTextSize = compactText ? size.small : largeText ? size.large : size.normal
// Dashboard sizing is independent from chart annotation sizing. This prevents
// the Standard chart typography preset from turning the panel into a large HUD.
string dashboardTitleSize = dashboardDensity == "Expanded" ? size.large : dashboardDensity == "Compact" ? size.small : size.normal
string dashboardValueSize = dashboardDensity == "Expanded" ? size.normal : size.small
string dashboardSectionSize = size.small
float primaryLabelOffsetATR = compactText ? 0.16 : largeText ? 0.30 : 0.22
float structureLabelOffsetATR = compactText ? 0.14 : largeText ? 0.26 : 0.19
float dashboardKeyWidth = dashboardDensity == "Compact" ? 6.0 : dashboardDensity == "Expanded" ? 9.0 : 7.0
float dashboardValueWidth = dashboardDensity == "Compact" ? 9.0 : dashboardDensity == "Expanded" ? 14.0 : 11.0
// Zero delegates row height to TradingView's text-fit sizing.
float dashboardRowHeight = 0.0
string dashboardPosition = dashboardPositionInput == "Top Left" ? position.top_left : dashboardPositionInput == "Bottom Right" ? position.bottom_right : position.top_right

// ------- BOUNDED HISTORICAL DRAWINGS -------
var label[] eventLabels = array.new_label()
var line[] externalEventLines = array.new_line()
var label[] externalEventLabels = array.new_label()
var bool[] externalEventUp = array.new_bool()   // direction of each external event (a Pine line cannot be queried for its colour)
var line[] internalEventLines = array.new_line()
var label[] internalEventLabels = array.new_label()

f_eventLabel(int x, float y, string title, color tone, bool above) =>
    int safeX = math.max(x, bar_index - 9999)
    float renderY = y + (above ? atr * primaryLabelOffsetATR : -atr * primaryLabelOffsetATR)
    // Pine exposes no pixel bounds. Use deterministic bar/ATR slots against
    // existing contextual and external-structure captions instead.
    for pass = 0 to 2
        bool occupied = false
        if array.size(eventLabels) > 0
            for i = 0 to array.size(eventLabels) - 1
                label existing = array.get(eventLabels, i)
                occupied := occupied or (math.abs(safeX - label.get_x(existing)) <= annotationBarSpacing and math.abs(renderY - label.get_y(existing)) <= atr * annotationATRSpacing)
        if array.size(externalEventLabels) > 0
            for i = 0 to array.size(externalEventLabels) - 1
                label existing = array.get(externalEventLabels, i)
                occupied := occupied or (math.abs(safeX - label.get_x(existing)) <= annotationBarSpacing and math.abs(renderY - label.get_y(existing)) <= atr * annotationATRSpacing)
        if occupied
            renderY += above ? atr * annotationATRSpacing : -atr * annotationATRSpacing
    label l = label.new(x = safeX, y = renderY, text = title, xloc = xloc.bar_index, yloc = yloc.price, style = above ? label.style_label_down : label.style_label_up, color = color.new(#090D18, 18), textcolor = tone, size = contextTextSize)
    array.push(eventLabels, l)
    if array.size(eventLabels) > maxEventLabels
        label.delete(array.shift(eventLabels))
    0

f_structureLine(int x1, int x2, float level, bool bullish, bool choch, bool internal) =>
    color c = bullish ? bullColor : bearColor
    int safeX1 = math.max(x1, x2 - 9999)
    line structureLine = line.new(x1 = safeX1, y1 = level, x2 = x2, y2 = level, xloc = xloc.bar_index, color = c, style = internal ? line.style_dotted : choch ? line.style_dashed : line.style_solid, width = internal ? 1 : 2)
    // Long lines (an old swing) would put the caption far from the break: centre it on the last 40 bars.
    int labelSpan = math.min(x2 - safeX1, 40)
    int midX = x2 - int(math.round(labelSpan / 2.0))
    string title = choch ? "CHoCH" : "BOS"
    // Keep both BOS and CHoCH captions centered and clearly below the line.
    float labelY = level - nz(atr, syminfo.mintick * 10) * structureLabelOffsetATR
    for pass = 0 to 2
        bool occupied = false
        if array.size(externalEventLabels) > 0
            for i = 0 to array.size(externalEventLabels) - 1
                label existing = array.get(externalEventLabels, i)
                occupied := occupied or (math.abs(midX - label.get_x(existing)) <= annotationBarSpacing and math.abs(labelY - label.get_y(existing)) <= atr * annotationATRSpacing)
        if array.size(internalEventLabels) > 0
            for i = 0 to array.size(internalEventLabels) - 1
                label existing = array.get(internalEventLabels, i)
                occupied := occupied or (math.abs(midX - label.get_x(existing)) <= annotationBarSpacing and math.abs(labelY - label.get_y(existing)) <= atr * annotationATRSpacing)
        if occupied
            labelY -= atr * annotationATRSpacing
    label structureLabel = label.new(x = midX, y = labelY, text = title, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_center, color = color.new(#090D18, 12), textcolor = c, size = structureTextSize)
    if internal
        array.push(internalEventLines, structureLine)
        array.push(internalEventLabels, structureLabel)
        if array.size(internalEventLines) > maxStructureEvents
            line.delete(array.shift(internalEventLines))
            label.delete(array.shift(internalEventLabels))
    else
        // A CHoCH starts a new structural phase. Retire stale phase history and
        // retain only the two most recent context-defining events behind it.
        if choch
            while array.size(externalEventLines) > 2
                line.delete(array.shift(externalEventLines))
                label.delete(array.shift(externalEventLabels))
                array.shift(externalEventUp)
        // One candle that closes beyond several swings is one break: keep the most recent swing.
        if not choch and array.size(externalEventLines) > 0
            int lastEvent = array.size(externalEventLines) - 1
            line previousLine = array.get(externalEventLines, lastEvent)
            label previousLabel = array.get(externalEventLabels, lastEvent)
            if line.get_x2(previousLine) == x2 and label.get_text(previousLabel) == "BOS" and array.get(externalEventUp, lastEvent) == bullish
                line.delete(array.pop(externalEventLines))
                label.delete(array.pop(externalEventLabels))
                array.pop(externalEventUp)
        array.push(externalEventLines, structureLine)
        array.push(externalEventLabels, structureLabel)
        array.push(externalEventUp, bullish)
        if array.size(externalEventLines) > effectiveExternalEvents
            line.delete(array.shift(externalEventLines))
            label.delete(array.shift(externalEventLabels))
            array.shift(externalEventUp)
    0

// zoneKind: 1 = OB; 2 = FVG; 3 = supply/demand.
// zoneSide: +1 = bullish; -1 = bearish.
var box[] zones = array.new_box()
var label[] zoneCaptionLabels = array.new_label()
var float[] zoneTops = array.new_float()
var float[] zoneBottoms = array.new_float()
var int[] zoneOrigins = array.new_int()
var int[] zoneKinds = array.new_int()
var int[] zoneSides = array.new_int()
var int[] zoneBirth = array.new_int()
var bool[] zoneTouched = array.new_bool()
var color[] zoneColors = array.new_color()
var string[] zoneTitles = array.new_string()
var bool[] zoneVisible = array.new_bool()
var bool[] zonePoi = array.new_bool()
var string[] zonePoiTitles = array.new_string()
var float[] zoneMitigation = array.new_float()
var string[] zoneQualification = array.new_string()
// v2.1: order-block metadata. Class 2 = swing (external structure), 1 = internal.
var int[] zoneClasses = array.new_int()
var string[] zoneEvents = array.new_string()
var line[] zoneMidLines = array.new_line()
var int[] zoneFirstTouch = array.new_int()   // bar of the first touch, -1 while untouched

// Order-block analytics survive visual suppression. Indices:
// 0 accepted, 1 rejected, 2 replaced by a newer block, 3 covered by a swing block,
// 4 mitigated, 5 invalidated, 6 aged out, 7 evicted from the retained store.
var int[] obStats = array.new_int(8, 0)
var string[] obDebugLog = array.new_string()
var label[] obDebugLabels = array.new_label()
var string[] obLastOutcome = array.new_string(1, "no candidate yet")

f_obLog(string entry) =>
    array.push(obDebugLog, entry)
    if array.size(obDebugLog) > 14
        array.shift(obDebugLog)
    0

f_removeZone(int idx) =>
    box oldBox = array.get(zones, idx)
    label oldCaption = array.get(zoneCaptionLabels, idx)
    line oldMid = array.get(zoneMidLines, idx)
    if not na(oldBox)
        box.delete(oldBox)
    if not na(oldCaption)
        label.delete(oldCaption)
    if not na(oldMid)
        line.delete(oldMid)
    array.remove(zones, idx)
    array.remove(zoneCaptionLabels, idx)
    array.remove(zoneTops, idx)
    array.remove(zoneBottoms, idx)
    array.remove(zoneOrigins, idx)
    array.remove(zoneKinds, idx)
    array.remove(zoneSides, idx)
    array.remove(zoneBirth, idx)
    array.remove(zoneTouched, idx)
    array.remove(zoneColors, idx)
    array.remove(zoneTitles, idx)
    array.remove(zoneVisible, idx)
    array.remove(zonePoi, idx)
    array.remove(zonePoiTitles, idx)
    array.remove(zoneMitigation, idx)
    array.remove(zoneQualification, idx)
    array.remove(zoneClasses, idx)
    array.remove(zoneEvents, idx)
    array.remove(zoneMidLines, idx)
    array.remove(zoneFirstTouch, idx)
    0

// zoneKind: 1 = OB; 2 = FVG; 3 = supply/demand.
// zoneSide: +1 = bullish; -1 = bearish.
// cls/event only carry meaning for order blocks (pass 0 / "" otherwise).
f_addZone(int origin, float top, float bottom, int side, int kind, string title, color tone, int cls, string event) =>
    if not na(top) and not na(bottom) and top > bottom
        bool duplicate = false
        // Order blocks resolve overlaps in f_obBuild (newest relevant block wins).
        if array.size(zones) > 0 and kind != 1
            for i = 0 to array.size(zones) - 1
                if array.get(zoneKinds, i) == kind and array.get(zoneSides, i) == side
                    float existingTop = array.get(zoneTops, i)
                    float existingBottom = array.get(zoneBottoms, i)
                    float overlap = math.min(top, existingTop) - math.max(bottom, existingBottom)
                    float smaller = math.min(top - bottom, existingTop - existingBottom)
                    duplicate := duplicate or (overlap > 0 and smaller > 0 and overlap / smaller >= 0.85)
        if not duplicate
            box zoneBox = na
            label zoneCaption = na
            line zoneMid = na
            array.push(zones, zoneBox)
            array.push(zoneCaptionLabels, zoneCaption)
            array.push(zoneTops, top)
            array.push(zoneBottoms, bottom)
            array.push(zoneOrigins, math.max(origin, bar_index - 9999))
            array.push(zoneKinds, kind)
            array.push(zoneSides, side)
            array.push(zoneBirth, bar_index)
            array.push(zoneTouched, false)
            array.push(zoneColors, tone)
            array.push(zoneTitles, title)
            array.push(zoneVisible, false)
            array.push(zonePoi, false)
            array.push(zonePoiTitles, "")
            array.push(zoneMitigation, 0.0)
            array.push(zoneQualification, "Candidate")
            array.push(zoneClasses, cls)
            array.push(zoneEvents, event)
            array.push(zoneMidLines, zoneMid)
            array.push(zoneFirstTouch, -1)
            // Capacity eviction removes imbalance zones first, then supply/demand,
            // and only then order blocks, so FVG volume cannot erase analytical OBs.
            if array.size(zones) > maxZones
                int evictIndex = -1
                for pass = 0 to 2
                    int evictKind = pass == 0 ? 2 : pass == 1 ? 3 : 1
                    for j = 0 to array.size(zones) - 1
                        if evictIndex < 0 and array.get(zoneKinds, j) == evictKind
                            evictIndex := j
                if evictIndex < 0
                    evictIndex := 0
                if array.get(zoneKinds, evictIndex) == 1
                    array.set(obStats, 7, array.get(obStats, 7) + 1)
                f_removeZone(evictIndex)
    0

// ------- MARKET STRUCTURE / INTERNAL + EXTERNAL CONFIRMED SWINGS -------
// External swings use an alternating candidate state machine. A candidate can
// extend to a more extreme pivot, but it is not published until the next leg
// clears the ATR-normalized displacement threshold.
var float lastSwingHigh = na
var float previousSwingHigh = na
var float lastSwingLow = na
var float previousSwingLow = na
var int lastHighBar = na
var int lastLowBar = na
var bool highBroken = false
var bool lowBroken = false
var bool externalHighSwept = false
var bool externalLowSwept = false
var int highBreakBar = na
var int lowBreakBar = na
var int bias = 0   // +1 bullish; -1 bearish; 0 neutral. External only.
var string lastBreak = "—"
var int lastBreakBar = na
var int lastBreakTime = na
var int lastHighTime = na
var int lastLowTime = na
var float protectedHigh = na
var float protectedLow = na
var int protectedHighBar = na
var int protectedLowBar = na
var int externalCandidateType = 0
var float candidateHigh = na
var float candidateLow = na
var int candidateHighBar = na
var int candidateLowBar = na
var label currentMajorHighTag = na
var label currentMajorLowTag = na
var line currentMajorHighLine = na
var line currentMajorLowLine = na
var int developingDirection = 0
var float developingHigh = na
var float developingLow = na
var int developingHighBar = na
var int developingLowBar = na
var line developingLine = na
var line activeLegLine = na
var line protectedLine = na
var string invalidatedText = "—"

var float lastInternalHigh = na
var float previousInternalHigh = na
var float lastInternalLow = na
var float previousInternalLow = na
var int lastInternalHighBar = na
var int lastInternalLowBar = na
var bool internalHighBroken = false
var bool internalLowBroken = false
var int internalBias = 0

bool newMajorHigh = false
bool newMajorLow = false
float majorHighPrice = na
float majorLowPrice = na
int majorHighBar = na
int majorLowBar = na

// Internal structure remains independent from external bias.
if newInternalHigh
    previousInternalHigh := lastInternalHigh
    lastInternalHigh := internalHigh
    lastInternalHighBar := bar_index - internalLength
    internalHighBroken := false
    if showInternal
        float tolerance = nz(atr[internalLength], atr) * equalTolerance
        string swingText = na(previousInternalHigh) ? "iSH" : math.abs(internalHigh - previousInternalHigh) <= tolerance ? "iEQH" : internalHigh > previousInternalHigh ? "iHH" : "iLH"
        f_eventLabel(lastInternalHighBar, internalHigh, swingText, bearColor, true)

if newInternalLow
    previousInternalLow := lastInternalLow
    lastInternalLow := internalLow
    lastInternalLowBar := bar_index - internalLength
    internalLowBroken := false
    if showInternal
        float tolerance = nz(atr[internalLength], atr) * equalTolerance
        string swingText = na(previousInternalLow) ? "iSL" : math.abs(internalLow - previousInternalLow) <= tolerance ? "iEQL" : internalLow > previousInternalLow ? "iHL" : "iLL"
        f_eventLabel(lastInternalLowBar, internalLow, swingText, bullColor, false)

bool internalUpBreak = barstate.isconfirmed and not na(lastInternalHigh) and not internalHighBroken and close > lastInternalHigh + atr * breakBuffer
bool internalDownBreak = barstate.isconfirmed and not na(lastInternalLow) and not internalLowBroken and close < lastInternalLow - atr * breakBuffer
var string lastInternalBreak = "—"
var int lastInternalBreakTime = na
bool internalUpChoch = false
bool internalDownChoch = false
if internalUpBreak
    bool internalChoch = internalBias == -1
    internalUpChoch := internalChoch
    lastInternalBreak := internalChoch ? "Bull CHoCH" : "Bull BOS"
    lastInternalBreakTime := time
    if showInternal
        f_structureLine(lastInternalHighBar, bar_index, lastInternalHigh, true, internalChoch, true)
    internalHighBroken := true
    internalBias := 1
if internalDownBreak
    bool internalChoch = internalBias == 1
    internalDownChoch := internalChoch
    lastInternalBreak := internalChoch ? "Bear CHoCH" : "Bear BOS"
    lastInternalBreakTime := time
    if showInternal
        f_structureLine(lastInternalLowBar, bar_index, lastInternalLow, false, internalChoch, true)
    internalLowBroken := true
    internalBias := -1

// Confirm and publish only alternating, meaningfully displaced external legs.
if newExternalHigh
    int candidateBar = bar_index - externalLength
    if debugMode
        f_eventLabel(candidateBar, externalHigh, "xEH", bearColor, true)
    if externalCandidateType == 0
        candidateHigh := externalHigh
        candidateHighBar := candidateBar
        externalCandidateType := 1
    else if externalCandidateType == 1
        if externalHigh > candidateHigh
            candidateHigh := externalHigh
            candidateHighBar := candidateBar
    else if externalHigh - candidateLow >= nz(atr[externalLength], atr) * (minLegATR + confirmATR)
        previousSwingLow := lastSwingLow
        lastSwingLow := candidateLow
        lastLowBar := candidateLowBar
        lastLowTime := bar_index - candidateLowBar <= 790 ? time[bar_index - candidateLowBar] : na
        lowBroken := false
        externalLowSwept := false
        lowBreakBar := na
        newMajorLow := true
        majorLowPrice := candidateLow
        majorLowBar := candidateLowBar
        developingDirection := 1
        developingHigh := math.max(externalHigh, high)
        developingHighBar := externalHigh >= high ? candidateBar : bar_index
        developingLow := na
        developingLowBar := na
        if not na(currentMajorLowLine)
            line.delete(currentMajorLowLine)
        currentMajorLowLine := na
        if showMajorLevels
            currentMajorLowLine := line.new(x1 = math.max(candidateLowBar, bar_index - 9999), y1 = candidateLow, x2 = bar_index + 5, y2 = candidateLow, xloc = xloc.bar_index, color = color.new(bullColor, 35), style = line.style_solid, width = 2)
        if minimalMode or not showHistoricalMajor
            if not na(currentMajorLowTag)
                label.delete(currentMajorLowTag)
            currentMajorLowTag := label.new(x = math.max(candidateLowBar, bar_index - 9999), y = candidateLow - nz(atr[externalLength], atr) * primaryLabelOffsetATR, text = "MAJOR LOW", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(#090D18, 16), textcolor = bullColor, size = majorTextSize, tooltip = "Confirmed external swing low")
        else if showHistoricalMajor
            float tolerance = nz(atr[externalLength], atr) * equalTolerance
            string swingText = na(previousSwingLow) ? "M SL" : math.abs(candidateLow - previousSwingLow) <= tolerance ? "M EQL" : candidateLow > previousSwingLow ? "M HL" : "M LL"
            f_eventLabel(candidateLowBar, candidateLow, swingText, bullColor, false)
        candidateHigh := externalHigh
        candidateHighBar := candidateBar
        externalCandidateType := 1

if newExternalLow
    int candidateBar = bar_index - externalLength
    if debugMode
        f_eventLabel(candidateBar, externalLow, "xEL", bullColor, false)
    if externalCandidateType == 0
        candidateLow := externalLow
        candidateLowBar := candidateBar
        externalCandidateType := -1
    else if externalCandidateType == -1
        if externalLow < candidateLow
            candidateLow := externalLow
            candidateLowBar := candidateBar
    else if candidateHigh - externalLow >= nz(atr[externalLength], atr) * (minLegATR + confirmATR)
        previousSwingHigh := lastSwingHigh
        lastSwingHigh := candidateHigh
        lastHighBar := candidateHighBar
        lastHighTime := bar_index - candidateHighBar <= 790 ? time[bar_index - candidateHighBar] : na
        highBroken := false
        externalHighSwept := false
        highBreakBar := na
        newMajorHigh := true
        majorHighPrice := candidateHigh
        majorHighBar := candidateHighBar
        developingDirection := -1
        developingLow := math.min(externalLow, low)
        developingLowBar := externalLow <= low ? candidateBar : bar_index
        developingHigh := na
        developingHighBar := na
        if not na(currentMajorHighLine)
            line.delete(currentMajorHighLine)
        currentMajorHighLine := na
        if showMajorLevels
            currentMajorHighLine := line.new(x1 = math.max(candidateHighBar, bar_index - 9999), y1 = candidateHigh, x2 = bar_index + 5, y2 = candidateHigh, xloc = xloc.bar_index, color = color.new(bearColor, 35), style = line.style_solid, width = 2)
        if minimalMode or not showHistoricalMajor
            if not na(currentMajorHighTag)
                label.delete(currentMajorHighTag)
            currentMajorHighTag := label.new(x = math.max(candidateHighBar, bar_index - 9999), y = candidateHigh + nz(atr[externalLength], atr) * primaryLabelOffsetATR, text = "MAJOR HIGH", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(#090D18, 16), textcolor = bearColor, size = majorTextSize, tooltip = "Confirmed external swing high")
        else if showHistoricalMajor
            float tolerance = nz(atr[externalLength], atr) * equalTolerance
            string swingText = na(previousSwingHigh) ? "M SH" : math.abs(candidateHigh - previousSwingHigh) <= tolerance ? "M EQH" : candidateHigh > previousSwingHigh ? "M HH" : "M LH"
            f_eventLabel(candidateHighBar, candidateHigh, swingText, bearColor, true)
        candidateLow := externalLow
        candidateLowBar := candidateBar
        externalCandidateType := -1

if showMajorLevels
    if not na(currentMajorHighLine)
        line.set_x2(currentMajorHighLine, highBroken and not na(highBreakBar) ? highBreakBar : bar_index + 5)
    if not na(currentMajorLowLine)
        line.set_x2(currentMajorLowLine, lowBroken and not na(lowBreakBar) ? lowBreakBar : bar_index + 5)

// The live extreme belongs to the active leg, not to confirmed structure. It
// updates immediately but remains visually dashed and is never called HH/LL.
if developingDirection == 1 and (na(developingHigh) or high > developingHigh)
    developingHigh := high
    developingHighBar := bar_index
if developingDirection == -1 and (na(developingLow) or low < developingLow)
    developingLow := low
    developingLowBar := bar_index

if showMajorLevels and developingDirection != 0
    float developingPrice = developingDirection == 1 ? developingHigh : developingLow
    int developingBar = developingDirection == 1 ? developingHighBar : developingLowBar
    color developingTone = developingDirection == 1 ? bullColor : bearColor
    float legStartPrice = developingDirection == 1 ? lastSwingLow : lastSwingHigh
    int legStartBar = developingDirection == 1 ? lastLowBar : lastHighBar
    if not na(developingPrice) and not na(developingBar)
        if na(developingLine)
            developingLine := line.new(math.max(developingBar, bar_index - 9999), developingPrice, bar_index + 5, developingPrice, xloc = xloc.bar_index, color = color.new(developingTone, 25), style = line.style_dashed, width = 1)
        else
            line.set_xy1(developingLine, math.max(developingBar, bar_index - 9999), developingPrice)
            line.set_xy2(developingLine, bar_index + 5, developingPrice)
            line.set_color(developingLine, color.new(developingTone, 25))
        if not na(legStartPrice) and not na(legStartBar)
            if na(activeLegLine)
                activeLegLine := line.new(math.max(legStartBar, bar_index - 9999), legStartPrice, developingBar, developingPrice, xloc = xloc.bar_index, color = color.new(developingTone, 62), style = line.style_solid, width = 1)
            else
                line.set_xy1(activeLegLine, math.max(legStartBar, bar_index - 9999), legStartPrice)
                line.set_xy2(activeLegLine, developingBar, developingPrice)
                line.set_color(activeLegLine, color.new(developingTone, 62))
else
    if not na(developingLine)
        line.delete(developingLine)
        developingLine := na
    if not na(activeLegLine)
        line.delete(activeLegLine)
        activeLegLine := na

// The latest opposite swing becomes the protected level once a trend has been
// established. This prevents an internal break from changing external bias.
if newMajorHigh and bias == -1
    protectedHigh := lastSwingHigh
    protectedHighBar := lastHighBar
if newMajorLow and bias == 1
    protectedLow := lastSwingLow
    protectedLowBar := lastLowBar

bool upBreak = barstate.isconfirmed and not na(lastSwingHigh) and not highBroken and close > lastSwingHigh + atr * (breakBuffer + confirmATR)
bool downBreak = barstate.isconfirmed and not na(lastSwingLow) and not lowBroken and close < lastSwingLow - atr * (breakBuffer + confirmATR)
bool externalBslSweep = barstate.isconfirmed and not na(lastSwingHigh) and not highBroken and not externalHighSwept and high > lastSwingHigh + atr * sweepBuffer and close < lastSwingHigh
bool externalSslSweep = barstate.isconfirmed and not na(lastSwingLow) and not lowBroken and not externalLowSwept and low < lastSwingLow - atr * sweepBuffer and close > lastSwingLow
bool upBOS = false
bool downBOS = false
bool upCHOCH = false
bool downCHOCH = false

// An external swing is published only after pivot confirmation and a displaced leg, so
// price may already have closed beyond it. Draw the break at the first such close; the
// event itself (bias, alerts, order blocks) still happens on the publication bar.
int upBreakBar = bar_index
int downBreakBar = bar_index
if upBreak and not na(lastHighBar)
    int upSpan = bar_index - lastHighBar - 1
    if upSpan >= 1 and upSpan <= 750
        for k = upSpan to 1
            if close[k] > lastSwingHigh + nz(atr[k], atr) * (breakBuffer + confirmATR)
                upBreakBar := bar_index - k
                break
if downBreak and not na(lastLowBar)
    int downSpan = bar_index - lastLowBar - 1
    if downSpan >= 1 and downSpan <= 750
        for k = downSpan to 1
            if close[k] < lastSwingLow - nz(atr[k], atr) * (breakBuffer + confirmATR)
                downBreakBar := bar_index - k
                break

if upBreak
    bool initialBreak = bias == 0
    bool choch = bias == -1 and not na(protectedHigh)
    if choch
        invalidatedText := "High · " + str.tostring(protectedHigh, format.mintick)
    upCHOCH := choch
    upBOS := not choch
    if showBreaks
        f_structureLine(lastHighBar, upBreakBar, lastSwingHigh, true, choch, false)
    highBroken := true
    highBreakBar := upBreakBar
    bias := 1
    developingDirection := 1
    developingHigh := high
    developingHighBar := bar_index
    developingLow := na
    developingLowBar := na
    lastBreakBar := bar_index
    lastBreakTime := time[bar_index - upBreakBar]
    protectedLow := lastSwingLow
    protectedLowBar := lastLowBar
    lastBreak := initialBreak ? "Bull initial break" : choch ? "Bull CHoCH" : "Bull BOS"
else if downBreak
    bool initialBreak = bias == 0
    bool choch = bias == 1 and not na(protectedLow)
    if choch
        invalidatedText := "Low · " + str.tostring(protectedLow, format.mintick)
    downCHOCH := choch
    downBOS := not choch
    if showBreaks
        f_structureLine(lastLowBar, downBreakBar, lastSwingLow, false, choch, false)
    lowBroken := true
    lowBreakBar := downBreakBar
    bias := -1
    developingDirection := -1
    developingLow := low
    developingLowBar := bar_index
    developingHigh := na
    developingHighBar := na
    lastBreakBar := bar_index
    lastBreakTime := time[bar_index - downBreakBar]
    protectedHigh := lastSwingHigh
    protectedHighBar := lastHighBar
    lastBreak := initialBreak ? "Bear initial break" : choch ? "Bear CHoCH" : "Bear BOS"

bool transitionContext = str.contains(lastBreak, "CHoCH") and not na(lastBreakBar) and bar_index - lastBreakBar <= externalLength * 2
bool expansionContext = bias == 1 ? (not na(lastSwingHigh) and close > lastSwingHigh) : bias == -1 ? (not na(lastSwingLow) and close < lastSwingLow) : false
bool rangeContext = not transitionContext and not expansionContext and not na(lastSwingHigh) and not na(lastSwingLow) and close <= lastSwingHigh and close >= lastSwingLow

// A confirmed level remains factual after it breaks, but it is visually
// retired so the developing extreme cannot be mistaken for the old boundary.
if not na(currentMajorHighLine)
    line.set_style(currentMajorHighLine, highBroken ? line.style_dotted : line.style_solid)
    line.set_color(currentMajorHighLine, color.new(bearColor, highBroken ? 78 : 35))
    line.set_x2(currentMajorHighLine, highBroken and not na(highBreakBar) ? highBreakBar : bar_index + 5)
if not na(currentMajorLowLine)
    line.set_style(currentMajorLowLine, lowBroken ? line.style_dotted : line.style_solid)
    line.set_color(currentMajorLowLine, color.new(bullColor, lowBroken ? 78 : 35))
    line.set_x2(currentMajorLowLine, lowBroken and not na(lowBreakBar) ? lowBreakBar : bar_index + 5)
if not na(currentMajorHighTag)
    label.set_textcolor(currentMajorHighTag, color.new(bearColor, highBroken ? 58 : 0))
if not na(currentMajorLowTag)
    label.set_textcolor(currentMajorLowTag, color.new(bullColor, lowBroken ? 58 : 0))

// Protected structure is secondary: dashed, current only, and automatically
// moved when a newly confirmed break establishes a different protected level.
float activeProtected = bias == 1 ? protectedLow : bias == -1 ? protectedHigh : na
int activeProtectedBar = bias == 1 ? protectedLowBar : bias == -1 ? protectedHighBar : na
color protectedTone = bias == 1 ? bullColor : bearColor
if showMajorLevels and not na(activeProtected) and not na(activeProtectedBar)
    if na(protectedLine)
        protectedLine := line.new(math.max(activeProtectedBar, bar_index - 9999), activeProtected, bar_index + 5, activeProtected, xloc = xloc.bar_index, color = color.new(protectedTone, 52), style = line.style_dashed, width = 1)
    else
        line.set_xy1(protectedLine, math.max(activeProtectedBar, bar_index - 9999), activeProtected)
        line.set_xy2(protectedLine, bar_index + 5, activeProtected)
        line.set_color(protectedLine, color.new(protectedTone, 52))
else
    if not na(protectedLine)
        line.delete(protectedLine)
        protectedLine := na

// ------- RIGHT-EDGE LABEL COLLECTOR -------
// Every right-edge level label (PROTECTED, DEV, BSL/SSL, EQ, Asia, iBSL/iSSL, premium /
// discount) is registered here instead of being drawn on its own. One pass at the end
// sorts them by price and merges labels closer than the spacing into a single label
// ("PROTECTED · BSL"), so right-edge text can never overlap. Priority decides which
// member sets the position and colour; the tooltip lists every member with its price.
float[] rlY = array.new_float()
string[] rlText = array.new_string()
color[] rlTone = array.new_color()
int[] rlPriority = array.new_int()
string[] rlTip = array.new_string()

f_regLabel(float y, string caption, color tone, int priority, string tip) =>
    if not na(y)
        array.push(rlY, y)
        array.push(rlText, caption)
        array.push(rlTone, tone)
        array.push(rlPriority, priority)
        array.push(rlTip, tip)
    0

// ------- LIQUIDITY POOLS (LEVEL-FIRST BSL / SSL) -------
// A pool exists only for a structurally significant level: a confirmed external
// swing, an equal-high/low band formed by independent tests, or an optional
// previous-day high/low. A lone internal pivot is held as an unpromoted candidate
// and is never drawn. Pool states: 0 active, 1 swept (grab), 2 consumed (accepted
// beyond, or broken by a close-confirmed structural BOS/CHoCH). Retired pools are
// removed from the store. Display filtering never changes pool state.
var line[] poolLines = array.new_line()
var label[] poolLabels = array.new_label()
var box[] poolBoxes = array.new_box()
var float[] poolTops = array.new_float()
var float[] poolBottoms = array.new_float()
var int[] poolSides = array.new_int()          // +1 BSL (above price), -1 SSL (below)
var int[] poolBirths = array.new_int()         // bar of the first qualifying test
var int[] poolConfirms = array.new_int()       // bar at which the pool qualified
var int[] poolLastTests = array.new_int()
var int[] poolTests = array.new_int()
var int[] poolDegrees = array.new_int()        // 1 internal EQ, 2 external swing, 3 external + EQ / session
var string[] poolKinds = array.new_string()    // Swing, EQ, PDH, PDL
var int[] poolStates = array.new_int()
var int[] poolStateBars = array.new_int()
var int[] poolPending = array.new_int()        // bar of first penetration awaiting a return, else -1
var float[] poolExtremes = array.new_float()
var int[] poolExtremeBars = array.new_int()
var int[] poolBeyond = array.new_int()         // consecutive closes beyond the pool
var bool[] poolVisible = array.new_bool()
var float[] ringPrices = array.new_float()     // unpromoted internal pivots
var int[] ringBars = array.new_int()
var int[] ringSides = array.new_int()
var int[] liqStats = array.new_int(5, 0)       // 0 created, 1 merged, 2 swept, 3 consumed, 4 retired
var line[] grabLines = array.new_line()
var string lastSweep = "—"
var int lastSweepBar = na
var int lastSweepSide = 0  // +1 supports bullish reversal; -1 bearish.

f_inc(int[] counters, int idx) =>
    array.set(counters, idx, array.get(counters, idx) + 1)
    0

f_poolRemove(int idx) =>
    line oldLine = array.get(poolLines, idx)
    label oldLabel = array.get(poolLabels, idx)
    box oldBox = array.get(poolBoxes, idx)
    if not na(oldLine)
        line.delete(oldLine)
    if not na(oldLabel)
        label.delete(oldLabel)
    if not na(oldBox)
        box.delete(oldBox)
    array.remove(poolLines, idx)
    array.remove(poolLabels, idx)
    array.remove(poolBoxes, idx)
    array.remove(poolTops, idx)
    array.remove(poolBottoms, idx)
    array.remove(poolSides, idx)
    array.remove(poolBirths, idx)
    array.remove(poolConfirms, idx)
    array.remove(poolLastTests, idx)
    array.remove(poolTests, idx)
    array.remove(poolDegrees, idx)
    array.remove(poolKinds, idx)
    array.remove(poolStates, idx)
    array.remove(poolStateBars, idx)
    array.remove(poolPending, idx)
    array.remove(poolExtremes, idx)
    array.remove(poolExtremeBars, idx)
    array.remove(poolBeyond, idx)
    array.remove(poolVisible, idx)
    0

f_poolNew(int side, float top, float bottom, int birth, int tests, int degree, string kind, int lastTest) =>
    line emptyLine = na
    label emptyLabel = na
    box emptyBox = na
    array.push(poolLines, emptyLine)
    array.push(poolLabels, emptyLabel)
    array.push(poolBoxes, emptyBox)
    array.push(poolTops, top)
    array.push(poolBottoms, bottom)
    array.push(poolSides, side)
    array.push(poolBirths, math.max(birth, bar_index - 9999))
    array.push(poolConfirms, bar_index)
    array.push(poolLastTests, lastTest)
    array.push(poolTests, tests)
    array.push(poolDegrees, degree)
    array.push(poolKinds, kind)
    array.push(poolStates, 0)
    array.push(poolStateBars, bar_index)
    array.push(poolPending, -1)
    array.push(poolExtremes, na)
    array.push(poolExtremeBars, -1)
    array.push(poolBeyond, 0)
    array.push(poolVisible, false)
    f_inc(liqStats, 0)
    if array.size(poolStates) > maxLiquidity
        // Evict consumed pools first, then the lowest structural degree, then the oldest.
        int evictIdx = 0
        float evictKey = 1.0e12
        for j = 0 to array.size(poolStates) - 1
            float key = (array.get(poolStates, j) != 0 ? 0.0 : 1.0e9) + array.get(poolDegrees, j) * 1.0e7 + array.get(poolConfirms, j)
            if key < evictKey
                evictKey := key
                evictIdx := j
        f_poolRemove(evictIdx)
    0

// Two tests are independent only if price pulled back between them and neither
// level was exceeded in between (otherwise the first was already swept).
f_pullbackOk(int side, int fromBar, int toBar, float priceA, float priceB, float tol, float atrRef) =>
    bool ok = false
    int span = bar_index - fromBar
    int newest = bar_index - toBar
    if span <= 750 and newest >= 0 and span >= newest
        float segHigh = high[newest]
        float segLow = low[newest]
        for k = newest to span
            segHigh := math.max(segHigh, high[k])
            segLow := math.min(segLow, low[k])
        if side == 1
            ok := segHigh <= math.max(priceA, priceB) + tol and segLow <= math.min(priceA, priceB) - eqMinPullbackATR * atrRef
        else
            ok := segLow >= math.min(priceA, priceB) - tol and segHigh >= math.max(priceA, priceB) + eqMinPullbackATR * atrRef
    ok

// degree: 1 = internal pivot candidate, 2 = confirmed external swing.
f_poolIngest(float price, int bar, int side, int degree, float tol, float atrRef) =>
    bool handled = false
    if array.size(poolStates) > 0
        for i = 0 to array.size(poolStates) - 1
            if not handled and array.get(poolStates, i) == 0 and array.get(poolSides, i) == side
                float ref = side == 1 ? array.get(poolTops, i) : array.get(poolBottoms, i)
                if math.abs(price - ref) <= tol
                    int lastTest = array.get(poolLastTests, i)
                    if bar - lastTest < eqMinSeparation
                        handled := true
                    else if not f_pullbackOk(side, lastTest, bar, ref, price, tol, atrRef)
                        handled := true
                    else
                        float newTop = math.max(array.get(poolTops, i), price)
                        float newBottom = math.min(array.get(poolBottoms, i), price)
                        if newTop - newBottom <= 2.0 * tol
                            array.set(poolTops, i, newTop)
                            array.set(poolBottoms, i, newBottom)
                            array.set(poolTests, i, array.get(poolTests, i) + 1)
                            array.set(poolLastTests, i, bar)
                            array.set(poolDegrees, i, degree >= 2 or array.get(poolDegrees, i) >= 2 ? 3 : 1)
                            array.set(poolKinds, i, "EQ")
                            f_inc(liqStats, 1)
                            handled := true
    if not handled and array.size(ringPrices) > 0
        for r = array.size(ringPrices) - 1 to 0
            if not handled and array.get(ringSides, r) == side and math.abs(price - array.get(ringPrices, r)) <= tol
                int ringBar = array.get(ringBars, r)
                float partner = array.get(ringPrices, r)
                if bar - ringBar < eqMinSeparation
                    if degree >= 2
                        array.remove(ringPrices, r)
                        array.remove(ringBars, r)
                        array.remove(ringSides, r)
                else if bar_index - ringBar <= 400 and f_pullbackOk(side, ringBar, bar, partner, price, tol, atrRef)
                    array.remove(ringPrices, r)
                    array.remove(ringBars, r)
                    array.remove(ringSides, r)
                    f_poolNew(side, math.max(price, partner), math.min(price, partner), ringBar, 2, degree >= 2 ? 3 : 1, "EQ", bar)
                    handled := true
    if not handled
        if degree >= 2
            f_poolNew(side, price, price, bar, 1, 2, "Swing", bar)
        else
            array.push(ringPrices, price)
            array.push(ringBars, bar)
            array.push(ringSides, side)
            if array.size(ringPrices) > 80
                array.shift(ringPrices)
                array.shift(ringBars)
                array.shift(ringSides)
    0

// A grab marks the rejection wick of the bar that made the extreme: the upper wick
// after a BSL sweep (bearish rejection), the lower wick after an SSL sweep (bullish).
// It is an annotation only; it never creates an entry or changes bias.
f_grabHighlight(int side, int extremeBar, float atrRef) =>
    int k = bar_index - extremeBar
    float wickTop = side == 1 ? high[k] : math.min(open[k], close[k])
    float wickBottom = side == 1 ? math.max(open[k], close[k]) : low[k]
    if wickTop - wickBottom >= grabMinWickATR * atrRef
        color grabTone = side == 1 ? bearColor : bullColor
        line grabLine = line.new(extremeBar, wickBottom, extremeBar, wickTop, xloc = xloc.bar_index, color = color.new(grabTone, 30), style = line.style_solid, width = 2)
        array.push(grabLines, grabLine)
        if array.size(grabLines) > sweepHistoryLimit
            line.delete(array.shift(grabLines))
    0

// External swing sweeps stay available as alert events. They no longer draw
// labels: the grab highlight below is driven by the pool that was swept.
if externalBslSweep
    externalHighSwept := true
    lastSweep := "External BSL swept"
    lastSweepBar := bar_index
    lastSweepSide := -1
if externalSslSweep
    externalLowSwept := true
    lastSweep := "External SSL swept"
    lastSweepBar := bar_index
    lastSweepSide := 1

// Previous-day high / low (completed day only, no repaint) are optional pools.
[pdHigh, pdLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
bool sessionPoolsValid = showSessionLiquidity and chartSecs <= 14400
bool newPdHigh = barstate.isconfirmed and sessionPoolsValid and not na(pdHigh) and (na(pdHigh[1]) or pdHigh != pdHigh[1])
bool newPdLow = barstate.isconfirmed and sessionPoolsValid and not na(pdLow) and (na(pdLow[1]) or pdLow != pdLow[1])

f_sessionPool(float price, int side, string kind) =>
    if array.size(poolStates) > 0
        for i = array.size(poolStates) - 1 to 0
            if array.get(poolKinds, i) == kind and array.get(poolStates, i) == 0
                f_poolRemove(i)
                f_inc(liqStats, 4)
    f_poolNew(side, price, price, bar_index, 1, 3, kind, bar_index)
    0

if barstate.isconfirmed and not na(atr)
    if newInternalHigh
        f_poolIngest(internalHigh, bar_index - internalLength, 1, 1, nz(atr[internalLength], atr) * equalTolerance, atr)
    if newInternalLow
        f_poolIngest(internalLow, bar_index - internalLength, -1, 1, nz(atr[internalLength], atr) * equalTolerance, atr)
    if newMajorHigh
        f_poolIngest(majorHighPrice, majorHighBar, 1, 2, nz(atr[externalLength], atr) * equalTolerance, atr)
    if newMajorLow
        f_poolIngest(majorLowPrice, majorLowBar, -1, 2, nz(atr[externalLength], atr) * equalTolerance, atr)
    if newPdHigh
        f_sessionPool(pdHigh, 1, "PDH")
    if newPdLow
        f_sessionPool(pdLow, -1, "PDL")

bool bslSweep = false
bool sslSweep = false
bool bslTaken = false
bool sslTaken = false

// A close-confirmed structural break consumes the pool resting on the broken
// external swing at once; the structural rule (one close beyond the swing plus the
// confirmation buffer) is deliberately separate from the sweep rule below.
if barstate.isconfirmed and (upBreak or downBreak) and array.size(poolStates) > 0 and not na(atr)
    for i = array.size(poolStates) - 1 to 0
        int breakSide = array.get(poolSides, i)
        bool brokenSide = (breakSide == 1 and upBreak) or (breakSide == -1 and downBreak)
        if brokenSide and array.get(poolStates, i) == 0 and array.get(poolConfirms, i) < bar_index
            float breakEdge = breakSide == 1 ? array.get(poolTops, i) : array.get(poolBottoms, i)
            float brokenLevel = breakSide == 1 ? lastSwingHigh : lastSwingLow
            if math.abs(breakEdge - brokenLevel) <= atr * equalTolerance
                array.set(poolStates, i, 2)
                array.set(poolStateBars, i, bar_index)
                f_inc(liqStats, 3)
                bslTaken := bslTaken or breakSide == 1
                sslTaken := sslTaken or breakSide == -1

// Sweep: wick penetration beyond the pool edge, then a close back inside it within
// the configured window. Consume: N consecutive closes beyond the edge by the break
// buffer. A pool leaves the active state once and therefore alerts once.
if barstate.isconfirmed and array.size(poolStates) > 0 and not na(atr)
    for i = array.size(poolStates) - 1 to 0
        int poolState = array.get(poolStates, i)
        int poolSide = array.get(poolSides, i)
        bool removeNow = false
        if poolState != 0
            int sinceState = bar_index - array.get(poolStateBars, i)
            removeNow := consumedPolicy == "Retire immediately" or (consumedPolicy == "Fade, then retire" and sinceState > consumedFadeBars)
        else if bar_index - array.get(poolBirths, i) > liqMaxAge
            removeNow := true
        else if bar_index > array.get(poolConfirms, i)
            float edge = poolSide == 1 ? array.get(poolTops, i) : array.get(poolBottoms, i)
            bool penetrated = poolSide == 1 ? high > edge + atr * sweepBuffer : low < edge - atr * sweepBuffer
            bool beyondClose = poolSide == 1 ? close > edge + atr * liqBreakBuffer : close < edge - atr * liqBreakBuffer
            int beyond = beyondClose ? array.get(poolBeyond, i) + 1 : 0
            array.set(poolBeyond, i, beyond)
            int pending = array.get(poolPending, i)
            if penetrated
                if pending < 0
                    pending := bar_index
                    array.set(poolPending, i, pending)
                    array.set(poolExtremes, i, poolSide == 1 ? high : low)
                    array.set(poolExtremeBars, i, bar_index)
                else
                    float priorExtreme = array.get(poolExtremes, i)
                    bool newExtreme = poolSide == 1 ? high > priorExtreme : low < priorExtreme
                    if newExtreme
                        array.set(poolExtremes, i, poolSide == 1 ? high : low)
                        array.set(poolExtremeBars, i, bar_index)
            bool returned = poolSide == 1 ? close < edge : close > edge
            bool windowOk = pending >= 0 and (sweepRule == "Same bar" ? pending == bar_index : bar_index - pending < sweepReturnBars)
            if beyond >= liqAcceptCloses
                array.set(poolStates, i, 2)
                array.set(poolStateBars, i, bar_index)
                f_inc(liqStats, 3)
                bslTaken := bslTaken or poolSide == 1
                sslTaken := sslTaken or poolSide == -1
            else if pending >= 0 and returned and windowOk
                array.set(poolStates, i, 1)
                array.set(poolStateBars, i, bar_index)
                f_inc(liqStats, 2)
                lastSweepBar := bar_index
                if poolSide == 1
                    bslSweep := true
                    lastSweep := "BSL swept · " + str.tostring(edge, format.mintick)
                    lastSweepSide := -1
                else
                    sslSweep := true
                    lastSweep := "SSL swept · " + str.tostring(edge, format.mintick)
                    lastSweepSide := 1
                if renderSweeps
                    f_grabHighlight(poolSide, array.get(poolExtremeBars, i), atr)
            else if pending >= 0 and not windowOk
                array.set(poolPending, i, -1)
        if removeNow
            f_inc(liqStats, 4)
            f_poolRemove(i)

// Pool drawing pass. A function so the main script body stays within TradingView's size limit; it
// only reads state and draws, and reports its counters through the arrays below.
int[] liqView = array.new_int(4, 0)            // 0 drawn active pools, 1 active, 2 swept, 3 consumed
float[] liqNearest = array.new_float(2, na)    // nearest active BSL above / SSL below price
bool[] liqNearestShown = array.new_bool(2, false)

f_renderPools() =>
    if array.size(poolStates) > 0
        int nearBsl = -1
        int nearSsl = -1
        float nearBslGap = 1.0e10
        float nearSslGap = 1.0e10
        for i = 0 to array.size(poolStates) - 1
            array.set(poolVisible, i, false)
            int scanState = array.get(poolStates, i)
            if scanState == 0
                f_inc(liqView, 1)
            if scanState == 1
                f_inc(liqView, 2)
            if scanState == 2
                f_inc(liqView, 3)
            if scanState == 0
                int scanSide = array.get(poolSides, i)
                float scanEdge = scanSide == 1 ? array.get(poolTops, i) : array.get(poolBottoms, i)
                if scanSide == 1 and scanEdge > close and scanEdge - close < nearBslGap
                    nearBsl := i
                    nearBslGap := scanEdge - close
                if scanSide == -1 and scanEdge < close and close - scanEdge < nearSslGap
                    nearSsl := i
                    nearSslGap := close - scanEdge
        array.set(liqNearest, 0, nearBsl >= 0 ? array.get(poolTops, nearBsl) : na)
        array.set(liqNearest, 1, nearSsl >= 0 ? array.get(poolBottoms, nearSsl) : na)
        float atrSafe = math.max(atr, syminfo.mintick)

        // Balanced selection: the nearest active BSL above and SSL below are always
        // considered; remaining slots go to structural degree first, then proximity.
        int shown = 0
        if renderLiquidity and effectiveVisibleLiquidity > 0
            if nearBsl >= 0 and nearBslGap / atrSafe <= effLiqNearestATR and f_scaleOk(array.get(poolTops, nearBsl))
                array.set(poolVisible, nearBsl, true)
                shown += 1
            if nearSsl >= 0 and nearSslGap / atrSafe <= effLiqNearestATR and f_scaleOk(array.get(poolBottoms, nearSsl)) and shown < effectiveVisibleLiquidity
                array.set(poolVisible, nearSsl, true)
                shown += 1
            if shown < effectiveVisibleLiquidity
                for pick = shown to effectiveVisibleLiquidity - 1
                    int bestPool = -1
                    float bestPoolScore = -1.0e10
                    for i = 0 to array.size(poolStates) - 1
                        if not array.get(poolVisible, i)
                            int candSide = array.get(poolSides, i)
                            float candEdge = candSide == 1 ? array.get(poolTops, i) : array.get(poolBottoms, i)
                            float candDistance = math.abs(close - candEdge) / atrSafe
                            if debugMode or (candDistance <= effLiqDistanceATR and f_scaleOk(candEdge))
                                float candScore = array.get(poolDegrees, i) * 1000.0 + (array.get(poolStates, i) == 0 ? 500.0 : 0.0) - candDistance * 10.0
                                if candScore > bestPoolScore
                                    bestPool := i
                                    bestPoolScore := candScore
                    if bestPool >= 0
                        array.set(poolVisible, bestPool, true)
                    else
                        break

        array.set(liqNearestShown, 0, nearBsl >= 0 and array.get(poolVisible, nearBsl))
        array.set(liqNearestShown, 1, nearSsl >= 0 and array.get(poolVisible, nearSsl))
        for i = 0 to array.size(poolStates) - 1
            line poolLine = array.get(poolLines, i)
            label poolLabel = array.get(poolLabels, i)
            box poolBox = array.get(poolBoxes, i)
            if array.get(poolVisible, i)
                int pSide = array.get(poolSides, i)
                int pState = array.get(poolStates, i)
                int pDegree = array.get(poolDegrees, i)
                int pTests = array.get(poolTests, i)
                int pBirth = array.get(poolBirths, i)
                int pStateBar = array.get(poolStateBars, i)
                float pTop = array.get(poolTops, i)
                float pBottom = array.get(poolBottoms, i)
                float pEdge = pSide == 1 ? pTop : pBottom
                string pKind = array.get(poolKinds, i)
                bool pActive = pState == 0
                if pActive
                    f_inc(liqView, 0)
                int leftX = math.max(pBirth, bar_index - maxDrawBars)
                int rightX = pActive ? bar_index + 5 : math.max(pStateBar, leftX + 1)
                color lineTone = color.new(liquidityColor, pActive ? 25 : 78)
                string baseName = pKind == "EQ" ? (pSide == 1 ? "EQH · BSL" : "EQL · SSL") : pKind == "PDH" ? "PDH · BSL" : pKind == "PDL" ? "PDL · SSL" : (pSide == 1 ? "BSL" : "SSL")
                string labelText = baseName + (pState == 1 ? " · swept" : pState == 2 ? " · taken" : "")
                string degreeText = pDegree == 1 ? "Internal equal level" : pDegree == 2 ? "External swing" : "External + equal / session level"
                string poolTip = baseName + " " + str.tostring(pEdge, format.mintick) + "\n" + degreeText + " · tests " + str.tostring(pTests) + "\n" + (pState == 0 ? "Active" : pState == 1 ? "Swept (grab)" : "Consumed") + " · age " + str.tostring(bar_index - pBirth) + " bars"
                if na(poolLine)
                    poolLine := line.new(leftX, pEdge, rightX, pEdge, xloc = xloc.bar_index, color = lineTone, style = line.style_dotted, width = 1)
                    array.set(poolLines, i, poolLine)
                else
                    line.set_xy1(poolLine, leftX, pEdge)
                    line.set_xy2(poolLine, rightX, pEdge)
                    line.set_color(poolLine, lineTone)
                if pKind == "EQ"
                    float bandMid = (pTop + pBottom) / 2.0
                    float bandHalf = math.max((pTop - pBottom) / 2.0, atrSafe * 0.03)
                    color bandFill = color.new(liquidityColor, pActive ? 86 : 95)
                    if na(poolBox)
                        poolBox := box.new(left = leftX, top = bandMid + bandHalf, right = rightX, bottom = bandMid - bandHalf, xloc = xloc.bar_index, border_color = color.new(liquidityColor, 100), bgcolor = bandFill)
                        array.set(poolBoxes, i, poolBox)
                    else
                        box.set_lefttop(poolBox, leftX, bandMid + bandHalf)
                        box.set_rightbottom(poolBox, rightX, bandMid - bandHalf)
                        box.set_bgcolor(poolBox, bandFill)
                else if not na(poolBox)
                    box.delete(poolBox)
                    box emptyPoolBox = na
                    array.set(poolBoxes, i, emptyPoolBox)
                if pActive
                    f_regLabel(pEdge, labelText, liquidityColor, pKind == "EQ" ? 62 : 60, poolTip)
                    if not na(poolLabel)
                        label.delete(poolLabel)
                        label emptyActiveLabel = na
                        array.set(poolLabels, i, emptyActiveLabel)
                else
                    // Consumed pools keep a small label at the event bar, away from the edge column.
                    if na(poolLabel)
                        poolLabel := label.new(rightX, pEdge, labelText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(#090D18, 70), textcolor = color.new(liquidityColor, 55), size = contextTextSize, tooltip = poolTip)
                        array.set(poolLabels, i, poolLabel)
                    else
                        label.set_xy(poolLabel, rightX, pEdge)
                        label.set_text(poolLabel, labelText)
                        label.set_tooltip(poolLabel, poolTip)
            else
                if not na(poolLine)
                    line.delete(poolLine)
                    line emptyPoolLine = na
                    array.set(poolLines, i, emptyPoolLine)
                if not na(poolLabel)
                    label.delete(poolLabel)
                    label emptyPoolLabel = na
                    array.set(poolLabels, i, emptyPoolLabel)
                if not na(poolBox)
                    box.delete(poolBox)
                    box emptyPoolBox2 = na
                    array.set(poolBoxes, i, emptyPoolBox2)
    0

if barstate.islast
    f_renderPools()
int relevantLiquidityCount = array.get(liqView, 0)
int poolActiveCount = array.get(liqView, 1)
int poolSweptCount = array.get(liqView, 2)
int poolConsumedCount = array.get(liqView, 3)
float nearestBslPrice = array.get(liqNearest, 0)
float nearestSslPrice = array.get(liqNearest, 1)
bool nearestBslShown = array.get(liqNearestShown, 0)
bool nearestSslShown = array.get(liqNearestShown, 1)

// ------- ORDER BLOCKS (STRUCTURE-ORIGIN, DISPLACEMENT-QUALIFIED) -------
// A block is built when an internal or external structure break closes. Origin: among
// the opposite-colour candles between the broken pivot and the break (capped by the
// search window), the one at the leg extreme (lowest low for a bullish block, highest
// high for a bearish one; the nearest wins ties). Qualification: base within tolerance
// of the leg extreme, bounded range, net displacement from the origin, a real impulse
// candle, and not already mitigated or invalidated before detection. Detection is
// independent of POI qualification and of the display budget.
f_obBuild(bool bull, int cls, string eventName, int anchorBar, float atrNow) =>
    int added = 0
    int maxBack = math.min(obSearchBars, bar_index - 1)
    int window = na(anchorBar) ? maxBack : math.min(maxBack, bar_index - anchorBar - 1)
    string reason = ""
    int bestK = -1
    float bestVal = na
    float extreme = na
    if window < 2
        reason := "window <2 bars"
    else
        for k = 1 to window
            float legValue = bull ? low[k] : high[k]
            extreme := na(extreme) ? legValue : bull ? math.min(extreme, legValue) : math.max(extreme, legValue)
            bool opposite = bull ? close[k] < open[k] : close[k] > open[k]
            if opposite
                if bestK < 0 or (bull ? legValue < bestVal : legValue > bestVal)
                    bestK := k
                    bestVal := legValue
    if reason == "" and bestK < 0
        reason := "no opposite-colour candle in window"
    float originHigh = bestK >= 0 ? high[bestK] : na
    float originLow = bestK >= 0 ? low[bestK] : na
    float baseGap = bestK >= 0 ? (bull ? bestVal - extreme : extreme - bestVal) : na
    if reason == "" and baseGap > obBaseToleranceATR * atrNow
        reason := "base is not an opposite candle (" + str.tostring(baseGap / atrNow, "0.00") + " ATR from leg extreme)"
    if reason == "" and originHigh - originLow > obMaxRangeATR * atrNow
        reason := "origin too wide (" + str.tostring((originHigh - originLow) / atrNow, "0.00") + " ATR)"
    float netMove = bestK >= 0 ? (bull ? close - originHigh : originLow - close) : na
    if reason == "" and netMove < obDisplacementATR * atrNow
        reason := "weak displacement (" + str.tostring(netMove / atrNow, "0.00") + " ATR < " + str.tostring(obDisplacementATR, "0.00") + ")"
    if reason == ""
        float bodyMax = 0.0
        for k = 0 to bestK - 1
            float bodySize = bull ? close[k] - open[k] : open[k] - close[k]
            bodyMax := math.max(bodyMax, bodySize)
        if bodyMax < obImpulseBodyATR * atrNow
            reason := "no impulse candle (max body " + str.tostring(bodyMax / atrNow, "0.00") + " ATR < " + str.tostring(obImpulseBodyATR, "0.00") + ")"
    float zTop = na
    float zBottom = na
    if reason == ""
        zTop := obWicks ? originHigh : math.max(open[bestK], close[bestK])
        zBottom := obWicks ? originLow : math.min(open[bestK], close[bestK])
        float zMid = (zTop + zBottom) / 2.0
        for k = 0 to bestK - 1
            bool dead = bull ? close[k] < zBottom : close[k] > zTop
            bool spent = obMitigationMethod == "Wick" ? (bull ? low[k] <= zBottom : high[k] >= zTop) : obMitigationMethod == "Midpoint" ? (bull ? low[k] <= zMid : high[k] >= zMid) : dead
            if reason == "" and (dead or spent)
                reason := "already " + (dead ? "invalidated" : "mitigated") + " before detection"
    int side = bull ? 1 : -1
    int finalClass = cls
    if reason == "" and array.size(zones) > 0
        // Prefer the newest relevant block; an internal block never displaces a swing block.
        for i = array.size(zones) - 1 to 0
            if reason == "" and array.get(zoneKinds, i) == 1 and array.get(zoneSides, i) == side
                float otherTop = array.get(zoneTops, i)
                float otherBottom = array.get(zoneBottoms, i)
                float overlapSize = math.min(zTop, otherTop) - math.max(zBottom, otherBottom)
                float smallerHeight = math.min(zTop - zBottom, otherTop - otherBottom)
                if overlapSize > 0 and smallerHeight > 0 and overlapSize / smallerHeight >= 0.5
                    if cls < array.get(zoneClasses, i)
                        reason := "covered by an existing swing OB"
                        f_inc(obStats, 3)
                    else
                        finalClass := math.max(cls, array.get(zoneClasses, i))
                        f_removeZone(i)
                        f_inc(obStats, 2)
    if reason == ""
        string titleText = (bull ? "Bull " : "Bear ") + (finalClass == 2 ? "OB" : "iOB")
        f_addZone(bar_index - bestK, zTop, zBottom, side, 1, titleText, bull ? bullColor : bearColor, finalClass, eventName)
        added := 1
        f_inc(obStats, 0)
        reason := "accepted"
    else if not str.contains(reason, "covered")
        f_inc(obStats, 1)
    string srcText = bestK >= 0 and bestK <= 790 ? str.format_time(time[bestK], "MM-dd HH:mm", syminfo.timezone) : "n/a"
    string logLine = (bull ? "BULL " : "BEAR ") + (cls == 2 ? "swing " : "int ") + eventName + " · src " + srcText + (added == 1 ? " · " + str.tostring(zBottom, format.mintick) + "-" + str.tostring(zTop, format.mintick) + " · ACCEPT" : " · REJECT: " + reason)
    f_obLog(logLine)
    array.set(obLastOutcome, 0, added == 1 ? "last candidate accepted" : "last rejected: " + reason)
    if showOBDebug
        label debugLabel = label.new(bar_index, bull ? low : high, (added == 1 ? "✓ " : "✗ ") + (cls == 2 ? "OB" : "iOB"), xloc = xloc.bar_index, yloc = yloc.price, style = bull ? label.style_label_up : label.style_label_down, color = color.new(#090D18, 25), textcolor = added == 1 ? bullColor : bearColor, size = size.tiny, tooltip = logLine)
        array.push(obDebugLabels, debugLabel)
        if array.size(obDebugLabels) > 14
            label.delete(array.shift(obDebugLabels))
    added

bool bullOB = false
bool bearOB = false
if showOB and barstate.isconfirmed and not na(atr)
    if upBreak
        int added = f_obBuild(true, 2, "External " + (upCHOCH ? "CHoCH" : "BOS"), lastHighBar, atr)
        bullOB := bullOB or added == 1
    if downBreak
        int added = f_obBuild(false, 2, "External " + (downCHOCH ? "CHoCH" : "BOS"), lastLowBar, atr)
        bearOB := bearOB or added == 1
    if showInternalOB and internalUpBreak
        int added = f_obBuild(true, 1, "Internal " + (internalUpChoch ? "CHoCH" : "BOS"), lastInternalHighBar, atr)
        bullOB := bullOB or added == 1
    if showInternalOB and internalDownBreak
        int added = f_obBuild(false, 1, "Internal " + (internalDownChoch ? "CHoCH" : "BOS"), lastInternalLowBar, atr)
        bearOB := bearOB or added == 1

// ------- SUPPLY / DEMAND FROM REJECTED, CONFIRMED EXTERNAL SWINGS -------
bool bullSD = false
bool bearSD = false
var int rejectedSDCount = 0
if showSD and newMajorLow
    float atrAtSwing = nz(atr[externalLength], atr)
    int swingOffset = bar_index - majorLowBar
    if swingOffset <= 799
        float upper = math.min(math.max(open[swingOffset], close[swingOffset]), majorLowPrice + atrAtSwing * sdMaxWidthATR)
        if externalHigh - majorLowPrice >= atrAtSwing * sdDepartureATR
            f_addZone(majorLowBar, upper, majorLowPrice, 1, 3, "Demand", demandColor, 0, "")
            bullSD := true

if showSD and newMajorHigh
    float atrAtSwing = nz(atr[externalLength], atr)
    int swingOffset = bar_index - majorHighBar
    if swingOffset <= 799
        float lower = math.max(math.min(open[swingOffset], close[swingOffset]), majorHighPrice - atrAtSwing * sdMaxWidthATR)
        if majorHighPrice - externalLow >= atrAtSwing * sdDepartureATR
            f_addZone(majorHighBar, majorHighPrice, lower, -1, 3, "Supply", supplyColor, 0, "")
            bearSD := true

if showSD and (newMajorLow or newMajorHigh) and not bullSD and not bearSD
    rejectedSDCount += 1

// ------- BASE-AND-IMPULSE SUPPLY / DEMAND (DBR / RBR / RBD / DBD) -------
// A base is 1..N consecutive small candles. A zone exists once price leaves the base
// with a real impulse and enough net distance, without closing back through it.
// Demand = departure up, supply = departure down. The pattern names the move into the
// base: drop-base-rally / rise-base-drop are reversals, rally-base-rally / drop-base-drop
// continuations. The zone is built on the bar the departure qualifies (up to
// `Departure window` bars after the base), so it appears with a short, bounded lag.
// sdStats: 0 accepted, 1 weak departure, 2 no impulse candle, 3 closed back through
// the base, 4 filtered by pattern, 5 duplicate, 6 retired by the retained-zone cap.
var int[] sdStats = array.new_int(7, 0)
var string[] sdLastOutcome = array.new_string(1, "no base yet")

// Returns 1 = demand added, 2 = supply added, 3 = duplicate (stop scanning), 0 = nothing.
f_baseImpulse(int nDep, float atrNow) =>
    int result = 0
    int baseCount = 0
    float baseHigh = na
    float baseLow = na
    bool scanning = true
    for m = 0 to sdBaseMaxBars - 1
        if scanning
            int k = nDep + m
            if k > bar_index - 1
                scanning := false
            else
                bool smallBar = high[k] - low[k] <= sdBaseBarRangeATR * atrNow and math.abs(close[k] - open[k]) <= sdBaseBodyATR * atrNow
                float newHigh = na(baseHigh) ? high[k] : math.max(baseHigh, high[k])
                float newLow = na(baseLow) ? low[k] : math.min(baseLow, low[k])
                if smallBar and newHigh - newLow <= sdMaxWidthATR * atrNow
                    baseHigh := newHigh
                    baseLow := newLow
                    baseCount += 1
                else
                    scanning := false
    if baseCount > 0
        float height = baseHigh - baseLow
        int firstBack = nDep + baseCount - 1
        bool up = close[nDep - 1] > baseHigh
        bool down = close[nDep - 1] < baseLow
        if up or down
            float bestClose = na
            float bodyMax = 0.0
            bool brokeBack = false
            for d = 0 to nDep - 1
                bestClose := na(bestClose) ? close[d] : up ? math.max(bestClose, close[d]) : math.min(bestClose, close[d])
                bodyMax := math.max(bodyMax, up ? close[d] - open[d] : open[d] - close[d])
                brokeBack := brokeBack or (up ? close[d] < baseLow : close[d] > baseHigh)
            float netDepart = up ? bestClose - baseHigh : baseLow - bestClose
            float needed = math.max(sdBaseDepartATR * atrNow, sdDepartRatio * height)
            string reason = ""
            if brokeBack
                reason := "departure closed back through the base"
                if nDep == 1
                    f_inc(sdStats, 3)
            else if netDepart < needed
                reason := "weak departure (" + str.tostring(netDepart / atrNow, "0.00") + " ATR < " + str.tostring(needed / atrNow, "0.00") + ")"
                if nDep == 1
                    f_inc(sdStats, 1)
            else if bodyMax < sdImpulseBodyATR * atrNow
                reason := "no impulse candle (max body " + str.tostring(bodyMax / atrNow, "0.00") + " ATR)"
                if nDep == 1
                    f_inc(sdStats, 2)
            if reason == ""
                float legIn = close[firstBack + 1] - close[firstBack + 1 + sdLegInBars]
                string pattern = up ? (legIn < 0 ? "DBR" : "RBR") : (legIn > 0 ? "RBD" : "DBD")
                bool reversal = pattern == "DBR" or pattern == "RBD"
                if sdPatternFilter == "Reversal only" and not reversal
                    reason := "continuation filtered"
                    f_inc(sdStats, 4)
                else if sdPatternFilter == "Continuation only" and reversal
                    reason := "reversal filtered"
                    f_inc(sdStats, 4)
                if reason == ""
                    float bodyHigh = na
                    float bodyLow = na
                    for b = nDep to firstBack
                        bodyHigh := na(bodyHigh) ? math.max(open[b], close[b]) : math.max(bodyHigh, math.max(open[b], close[b]))
                        bodyLow := na(bodyLow) ? math.min(open[b], close[b]) : math.min(bodyLow, math.min(open[b], close[b]))
                    float zTop = up ? (sdProximal == "Wick" ? baseHigh : bodyHigh) : baseHigh
                    float zBottom = up ? baseLow : (sdProximal == "Wick" ? baseLow : bodyLow)
                    int zSide = up ? 1 : -1
                    bool duplicate = false
                    if array.size(zones) > 0 and zTop > zBottom
                        for z = 0 to array.size(zones) - 1
                            if array.get(zoneKinds, z) == 3 and array.get(zoneSides, z) == zSide
                                float ot = array.get(zoneTops, z)
                                float ob = array.get(zoneBottoms, z)
                                float ov = math.min(zTop, ot) - math.max(zBottom, ob)
                                float sm = math.min(zTop - zBottom, ot - ob)
                                duplicate := duplicate or (ov > 0 and sm > 0 and ov / sm >= 0.85)
                    if duplicate
                        f_inc(sdStats, 5)
                        result := 3
                    else if zTop > zBottom
                        string zTitle = (up ? "Demand · " : "Supply · ") + pattern
                        f_addZone(bar_index - firstBack, zTop, zBottom, zSide, 3, zTitle, up ? demandColor : supplyColor, 1, pattern)
                        f_inc(sdStats, 0)
                        array.set(sdLastOutcome, 0, "last base accepted · " + pattern)
                        result := up ? 1 : 2
            if reason != ""
                array.set(sdLastOutcome, 0, "last base rejected: " + reason)
    result

bool bullBase = false
bool bearBase = false
if showBaseSD and barstate.isconfirmed and not na(atr) and bar_index > 40
    for nDep = 1 to sdDepartBars
        int baseResult = f_baseImpulse(nDep, atr)
        if baseResult != 0
            bullBase := bullBase or baseResult == 1
            bearBase := bearBase or baseResult == 2
            break
    // Keep the newest `Retained base-and-impulse zones`; swing zones are never touched.
    int baseZoneCount = 0
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            baseZoneCount += array.get(zoneKinds, i) == 3 and array.get(zoneClasses, i) == 1 ? 1 : 0
        for i = 0 to array.size(zones) - 1
            if baseZoneCount > sdMaxBaseZones and array.get(zoneKinds, i) == 3 and array.get(zoneClasses, i) == 1
                f_removeZone(i)
                f_inc(sdStats, 6)
                baseZoneCount -= 1
                break

// ------- FAIR VALUE GAPS: [0] and [2] do not overlap; [1] is displaced -------
bool rawBullFVG = barstate.isconfirmed and showFVG and bar_index >= 2 and low > high[2]
bool rawBearFVG = barstate.isconfirmed and showFVG and bar_index >= 2 and high < low[2]
bool bullFVG = barstate.isconfirmed and showFVG and bar_index >= 2 and low > high[2] and low - high[2] >= atr * minGapATR and math.abs(close[1] - open[1]) >= nz(atr[1], atr) * fvgImpulseATR
bool bearFVG = barstate.isconfirmed and showFVG and bar_index >= 2 and high < low[2] and low[2] - high >= atr * minGapATR and math.abs(close[1] - open[1]) >= nz(atr[1], atr) * fvgImpulseATR
var int rejectedFVGCount = 0
if bullFVG
    f_addZone(bar_index - 2, low, high[2], 1, 2, "Bull FVG", bullFvgColor, 0, "")
if bearFVG
    f_addZone(bar_index - 2, low[2], high, -1, 2, "Bear FVG", bearFvgColor, 0, "")
if (rawBullFVG and not bullFVG) or (rawBearFVG and not bearFVG)
    rejectedFVGCount += 1

// Named POI qualification path of zone i ("Candidate" = not qualified). Used by the display
// pass and by the trade plan so a trade can only start from a zone that is marked as a POI.
// `fresh` is passed in because the trade plan evaluates a zone on the bar that first touches it.
f_poiPath(int i, bool fresh) =>
    int side = array.get(zoneSides, i)
    int kind = array.get(zoneKinds, i)
    int born = array.get(zoneBirth, i)
    float top = array.get(zoneTops, i)
    float bottom = array.get(zoneBottoms, i)
    bool hasOB = kind == 1
    bool hasFVG = kind == 2
    bool hasSD = kind == 3
    if array.size(zones) > 1
        for j = 0 to array.size(zones) - 1
            if j != i and array.get(zoneSides, j) == side
                float otherTop = array.get(zoneTops, j)
                float otherBottom = array.get(zoneBottoms, j)
                float overlapSize = math.min(top, otherTop) - math.max(bottom, otherBottom)
                float smallerHeight = math.min(top - bottom, otherTop - otherBottom)
                if overlapSize > 0 and smallerHeight > 0 and overlapSize / smallerHeight >= 0.25
                    int otherKind = array.get(zoneKinds, j)
                    hasOB := hasOB or otherKind == 1
                    hasFVG := hasFVG or otherKind == 2
                    hasSD := hasSD or otherKind == 3
    bool componentConfluence = (hasOB and hasFVG) or (hasOB and hasSD) or (hasFVG and hasSD)
    bool structureRelated = not na(lastBreakBar) and born >= lastBreakBar - obLookback and born - lastBreakBar <= poiStructureWindow
    bool structureOriginOB = kind == 1 and array.get(zoneClasses, i) == 2 and side == bias and structureRelated
    bool displacedSwingZone = kind == 3 and array.get(zoneClasses, i) == 0 and side == bias
    bool baseImpulseZone = kind == 3 and array.get(zoneClasses, i) == 1 and side == bias and fresh
    bool sweptImbalance = kind == 2 and side == bias and lastSweepSide == side and not na(lastSweepBar) and math.abs(born - lastSweepBar) <= poiStructureWindow
    string path = componentConfluence ? "Composite" : structureOriginOB ? "Structure-origin OB" : displacedSwingZone ? "Displaced swing zone" : baseImpulseZone ? "Base-impulse zone" : sweptImbalance ? "Swept imbalance" : "Candidate"
    path

// Zone drawing pass. A function so the main script body stays within TradingView's size limit.
// Hidden zones have no box object, so they cannot distort chart autoscaling; they are recreated
// when ranking qualifies them.
f_renderZones() =>
    // Rendering pass. Hidden zones have no box object, so they cannot distort
    // chart autoscaling; they can be recreated later when ranking qualifies them.
    for i = 0 to array.size(zones) - 1
        box zoneBox = array.get(zones, i)
        bool visible = array.get(zoneVisible, i)
        if visible
            float top = array.get(zoneTops, i)
            float bottom = array.get(zoneBottoms, i)
            int origin = array.get(zoneOrigins, i)
            int kind = array.get(zoneKinds, i)
            int side = array.get(zoneSides, i)
            bool touched = array.get(zoneTouched, i)
            bool poi = array.get(zonePoi, i)
            color tone = array.get(zoneColors, i)
            string title = poi ? array.get(zonePoiTitles, i) : array.get(zoneTitles, i)
            bool isOB = kind == 1
            int obClass = array.get(zoneClasses, i)
            string obName = (obClass == 1 ? "iOB" : "OB") + (touched ? " · T" : "")
            string shortTitle = poi ? title : isOB ? obName : array.get(zoneTitles, i)
            float mitigation = array.get(zoneMitigation, i)
            string zoneState = array.get(zoneQualification, i)
            string obTipLine = isOB ? array.get(zoneEvents, i) + " · " + (obClass == 2 ? "swing" : "internal") + " · " + (touched ? "Tested" : "Fresh") + " · mitigation " + obMitigationMethod + "\n" : kind == 3 and obClass == 1 ? "Base-and-impulse " + array.get(zoneEvents, i) + " · " + (touched ? "Tested" : "Fresh") + "\n" : ""
            string zoneTooltip = title + "\n" + obTipLine + zoneState + "\nMitigated " + str.tostring(mitigation * 100.0, "#.0") + "%\n" + str.tostring(bottom, format.mintick) + " — " + str.tostring(top, format.mintick)
            float zoneMid = (top + bottom) / 2.0
            bool tallZone = top - bottom >= atr * (largeText ? 0.45 : compactText ? 0.20 : 0.32)
            bool suppressCaption = false
            if not poi and array.size(zones) > 1
                for j = 0 to array.size(zones) - 1
                    if j != i and array.get(zoneVisible, j) and array.get(zonePoi, j)
                        float poiTop = array.get(zoneTops, j)
                        float poiBottom = array.get(zoneBottoms, j)
                        suppressCaption := suppressCaption or math.min(top, poiTop) - math.max(bottom, poiBottom) > 0
            string insideText = tallZone and not suppressCaption ? shortTitle : ""
            color zoneBorder = isOB ? color.new(tone, touched ? 72 : 42) : poi ? color.new(tone, 10) : color.new(tone, touched ? 75 : 50)
            int zoneBorderWidth = isOB ? 1 : poi ? 2 : 1
            string zoneBorderStyle = isOB and touched ? line.style_dashed : line.style_solid
            color zoneFill = isOB ? color.new(tone, touched ? 95 : math.min(97, zoneOpacity + 2)) : color.new(tone, touched ? 96 : poi ? math.max(82, zoneOpacity - 3) : zoneOpacity)
            int drawLeft = math.max(origin, bar_index - maxDrawBars)
            if na(zoneBox)
                zoneBox := box.new(left = drawLeft, top = top, right = bar_index + 5, bottom = bottom, xloc = xloc.bar_index, border_color = zoneBorder, border_width = zoneBorderWidth, border_style = zoneBorderStyle, bgcolor = zoneFill, text = insideText, text_color = tone, text_size = zoneTextSize, text_halign = text.align_right)
                array.set(zones, i, zoneBox)
            else
                box.set_left(zoneBox, drawLeft)
                box.set_right(zoneBox, bar_index + 5)
                box.set_border_color(zoneBox, zoneBorder)
                box.set_border_width(zoneBox, zoneBorderWidth)
                box.set_border_style(zoneBox, zoneBorderStyle)
                box.set_bgcolor(zoneBox, zoneFill)
                box.set_text(zoneBox, insideText)
                box.set_text_color(zoneBox, tone)
                box.set_text_size(zoneBox, zoneTextSize)
                box.set_text_halign(zoneBox, text.align_right)
            line zoneMidLine = array.get(zoneMidLines, i)
            if isOB and showOBMidline
                if na(zoneMidLine)
                    zoneMidLine := line.new(drawLeft, zoneMid, bar_index + 5, zoneMid, xloc = xloc.bar_index, color = color.new(tone, 55), style = line.style_dotted, width = 1)
                    array.set(zoneMidLines, i, zoneMidLine)
                else
                    line.set_x1(zoneMidLine, drawLeft)
                    line.set_x2(zoneMidLine, bar_index + 5)
            else if not na(zoneMidLine)
                line.delete(zoneMidLine)
                line emptyMidLine = na
                array.set(zoneMidLines, i, emptyMidLine)
            label zoneCaption = array.get(zoneCaptionLabels, i)
            if not tallZone and not suppressCaption
                float captionY = zoneMid
                if i > 0
                    for j = 0 to i - 1
                        label otherCaption = array.get(zoneCaptionLabels, j)
                        if not na(otherCaption) and array.get(zoneVisible, j) and math.abs(captionY - label.get_y(otherCaption)) <= atr * annotationATRSpacing
                            if poi and not array.get(zonePoi, j)
                                label.delete(otherCaption)
                                label emptyCaption = na
                                array.set(zoneCaptionLabels, j, emptyCaption)
                            else
                                captionY += side == 1 ? -atr * annotationATRSpacing : atr * annotationATRSpacing
                float developingReference = developingDirection == 1 ? developingHigh : developingDirection == -1 ? developingLow : na
                if not na(developingReference) and math.abs(captionY - developingReference) <= atr * annotationATRSpacing
                    captionY += side == 1 ? -atr * annotationATRSpacing : atr * annotationATRSpacing
                if not na(activeProtected) and math.abs(captionY - activeProtected) <= atr * annotationATRSpacing
                    captionY += side == 1 ? -atr * annotationATRSpacing : atr * annotationATRSpacing
                if not na(lastSwingHigh) and math.abs(captionY - lastSwingHigh) <= atr * annotationATRSpacing
                    captionY += side == 1 ? -atr * annotationATRSpacing : atr * annotationATRSpacing
                if not na(lastSwingLow) and math.abs(captionY - lastSwingLow) <= atr * annotationATRSpacing
                    captionY += side == 1 ? -atr * annotationATRSpacing : atr * annotationATRSpacing
                if na(zoneCaption)
                    zoneCaption := label.new(bar_index + 6, captionY, shortTitle, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(#090D18, 18), textcolor = tone, size = zoneTextSize, tooltip = zoneTooltip)
                    array.set(zoneCaptionLabels, i, zoneCaption)
                else
                    label.set_xy(zoneCaption, bar_index + 6, captionY)
                    label.set_text(zoneCaption, shortTitle)
                    label.set_color(zoneCaption, color.new(#090D18, 18))
                    label.set_textcolor(zoneCaption, tone)
                    label.set_size(zoneCaption, zoneTextSize)
                    label.set_tooltip(zoneCaption, zoneTooltip)
            else if not na(zoneCaption)
                label.delete(zoneCaption)
                label emptyCaption = na
                array.set(zoneCaptionLabels, i, emptyCaption)
        else
            if not na(zoneBox)
                box.delete(zoneBox)
                box hiddenBox = na
                array.set(zones, i, hiddenBox)
            label hiddenCaption = array.get(zoneCaptionLabels, i)
            if not na(hiddenCaption)
                label.delete(hiddenCaption)
                label emptyCaption = na
                array.set(zoneCaptionLabels, i, emptyCaption)
            line hiddenMid = array.get(zoneMidLines, i)
            if not na(hiddenMid)
                line.delete(hiddenMid)
                line emptyMidLine = na
                array.set(zoneMidLines, i, emptyMidLine)
    0

// Closed-bar zone management. FVG invalidation follows the selected wick,
// midpoint, or close policy; OB and supply/demand require a far-edge close.
float nearestBullPoi = na
float nearestBearPoi = na
float nearestBullPoiDistanceATR = na
float nearestBearPoiDistanceATR = na
float nearestActionableBullPoi = na
float nearestActionableBearPoi = na
float nearestActionableBullDistanceATR = na
float nearestActionableBearDistanceATR = na
bool actionableBullPoi = false
bool actionableBearPoi = false
float bullPoiBarrier = na
float bearPoiBarrier = na
string nearestBullPoiText = "—"
string nearestBearPoiText = "—"
string poiContextText = "No qualified POI"
string opposingBarrierText = "—"
int visibleOB = 0
int visibleFVG = 0
int visibleSD = 0
int activeOB = 0
int activeFVG = 0
int activeSD = 0
int activeBaseSD = 0
int visibleBaseSD = 0
int qualifiedPoiCount = 0
int hiddenDistanceCount = 0
int hiddenRankingCount = 0
int activeBullOB = 0
int activeBearOB = 0
int visibleBullOB = 0
int visibleBearOB = 0
int hiddenOBFar = 0
int hiddenOBOverlap = 0
int hiddenOBBudget = 0
string[] obDebugRows = array.new_string()
var int invalidatedZoneCount = 0
var int agedZoneCount = 0

if array.size(zones) > 0
    // Lifecycle pass. Analytical state survives visual suppression.
    for i = array.size(zones) - 1 to 0
        box zoneBox = array.get(zones, i)
        int side = array.get(zoneSides, i)
        int kind = array.get(zoneKinds, i)
        int born = array.get(zoneBirth, i)
        float top = array.get(zoneTops, i)
        float bottom = array.get(zoneBottoms, i)
        if barstate.isconfirmed and bar_index > born
            float zoneHeight = top - bottom
            float penetration = side == 1 ? (top - low) / zoneHeight : (high - bottom) / zoneHeight
            float mitigationDepth = math.max(array.get(zoneMitigation, i), math.max(0.0, math.min(1.0, penetration)))
            array.set(zoneMitigation, i, mitigationDepth)
            float zoneMidPrice = (top + bottom) / 2.0
            bool farClose = side == 1 ? close < bottom : close > top
            bool fvgInvalid = fvgMitigationMethod == "Close" ? (side == 1 ? close <= bottom : close >= top) : fvgMitigationMethod == "Midpoint" ? (side == 1 ? low <= zoneMidPrice : high >= zoneMidPrice) : mitigationDepth >= 1.0
            // Order blocks: Invalidated = a close beyond the far edge (always); Mitigated =
            // the configured rule (Wick reaches the far edge, Midpoint reaches the 50% level,
            // Close = a close beyond the far edge). A partial touch only marks the block Tested.
            bool obMitigated = obMitigationMethod == "Wick" ? (side == 1 ? low <= bottom : high >= top) : obMitigationMethod == "Midpoint" ? (side == 1 ? low <= zoneMidPrice : high >= zoneMidPrice) : farClose
            bool invalid = kind == 2 ? fvgInvalid : kind == 1 ? (farClose or obMitigated) : farClose
            bool agedOut = bar_index - born > zoneMaxAge
            if invalid or agedOut
                invalidatedZoneCount += invalid ? 1 : 0
                agedZoneCount += agedOut and not invalid ? 1 : 0
                if kind == 1
                    int endStat = farClose ? 5 : invalid ? 4 : 6
                    f_inc(obStats, endStat)
                    array.set(obLastOutcome, 0, farClose ? "last OB invalidated" : invalid ? "last OB mitigated" : "last OB aged out")
                    f_obLog((side == 1 ? "BULL " : "BEAR ") + array.get(zoneEvents, i) + " · " + str.tostring(bottom, format.mintick) + "-" + str.tostring(top, format.mintick) + " · " + (farClose ? "INVALIDATED (close beyond far edge)" : invalid ? "MITIGATED (" + obMitigationMethod + ")" : "RETIRED (age)"))
                f_removeZone(i)
            else
                if not array.get(zoneTouched, i) and mitigationDepth > 0
                    array.set(zoneTouched, i, true)
                    array.set(zoneFirstTouch, i, bar_index)

    if array.size(zones) > 0 and barstate.islast
        // POI qualification pass. Confluence requires at least two independent
        // inputs; freshness and bias alignment alone never promote an FVG.
        for i = 0 to array.size(zones) - 1
            array.set(zoneVisible, i, false)
            int side = array.get(zoneSides, i)
            int kind = array.get(zoneKinds, i)
            int born = array.get(zoneBirth, i)
            float top = array.get(zoneTops, i)
            float bottom = array.get(zoneBottoms, i)
            bool fresh = not array.get(zoneTouched, i)
            bool hasOB = kind == 1
            bool hasFVG = kind == 2
            bool hasSD = kind == 3
            if array.size(zones) > 1
                for j = 0 to array.size(zones) - 1
                    if j != i and array.get(zoneSides, j) == side
                        float otherTop = array.get(zoneTops, j)
                        float otherBottom = array.get(zoneBottoms, j)
                        float overlapSize = math.min(top, otherTop) - math.max(bottom, otherBottom)
                        float smallerHeight = math.min(top - bottom, otherTop - otherBottom)
                        bool meaningfulOverlap = overlapSize > 0 and smallerHeight > 0 and overlapSize / smallerHeight >= 0.25
                        if meaningfulOverlap
                            int otherKind = array.get(zoneKinds, j)
                            hasOB := hasOB or otherKind == 1
                            hasFVG := hasFVG or otherKind == 2
                            hasSD := hasSD or otherKind == 3
            // Named qualification paths replace the v1.x summed confluence score.
            // Proximity and display rank never promote a candidate.
            string qualificationPath = f_poiPath(i, fresh)
            bool qualifiedPoi = qualificationPath != "Candidate"
            string sideName = side == 1 ? "Bull" : "Bear"
            string sdName = side == 1 ? "Demand" : "Supply"
            string poiTitle = hasOB and hasFVG ? "POI · " + sideName + " OB + FVG" : hasOB and hasSD ? "POI · " + sdName + " + OB" : hasFVG and hasSD ? "POI · " + sdName + " + FVG" : "POI · " + array.get(zoneTitles, i)
            array.set(zonePoi, i, qualifiedPoi)
            array.set(zonePoiTitles, i, qualifiedPoi ? poiTitle : "")
            array.set(zoneQualification, i, fresh ? (qualifiedPoi ? "Qualified · " + qualificationPath : "Candidate") : "Tested · " + qualificationPath)

        // Analytical POI pass is independent of visual ranking. Hidden qualified
        // zones still participate in nearest-distance and barrier calculations.
        for i = 0 to array.size(zones) - 1
            if array.get(zonePoi, i)
                float poiTop = array.get(zoneTops, i)
                float poiBottom = array.get(zoneBottoms, i)
                float poiMid = (poiTop + poiBottom) / 2.0
                float poiDistance = math.abs(close - poiMid) / math.max(atr, syminfo.mintick)
                int poiSide = array.get(zoneSides, i)
                string poiName = poiSide == 1 ? "Bull" : "Bear"
                if poiSide == 1 and (na(nearestBullPoi) or poiDistance < nearestBullPoiDistanceATR)
                    nearestBullPoi := poiMid
                    nearestBullPoiDistanceATR := poiDistance
                    nearestBullPoiText := poiName + " · " + str.tostring(poiMid, format.mintick) + " · " + str.tostring(poiDistance, "#.0") + " ATR"
                if poiSide == -1 and (na(nearestBearPoi) or poiDistance < nearestBearPoiDistanceATR)
                    nearestBearPoi := poiMid
                    nearestBearPoiDistanceATR := poiDistance
                    nearestBearPoiText := poiName + " · " + str.tostring(poiMid, format.mintick) + " · " + str.tostring(poiDistance, "#.0") + " ATR"

        // Select the nearest genuinely actionable POI separately from the
        // nearest qualified POI. Each candidate must be fresh, close enough,
        // on the relevant side of price, and have one ATR of room when an
        // opposing confirmed swing or qualified zone exists.
        for i = 0 to array.size(zones) - 1
            if array.get(zonePoi, i)
                int candidateSide = array.get(zoneSides, i)
                float candidateMid = (array.get(zoneTops, i) + array.get(zoneBottoms, i)) / 2.0
                float candidateDistance = math.abs(close - candidateMid) / math.max(atr, syminfo.mintick)
                bool candidateFresh = not array.get(zoneTouched, i)
                bool technicallyRelevant = candidateSide == 1 ? candidateMid <= close : candidateMid >= close
                bool baseActionable = candidateFresh and technicallyRelevant and candidateDistance <= actionablePoiDistanceATR
                if baseActionable
                    float candidateBarrier = candidateSide == 1 ? (not na(lastSwingHigh) and lastSwingHigh > candidateMid ? lastSwingHigh : na) : (not na(lastSwingLow) and lastSwingLow < candidateMid ? lastSwingLow : na)
                    if array.size(zones) > 1
                        for j = 0 to array.size(zones) - 1
                            if j != i and array.get(zonePoi, j) and array.get(zoneSides, j) == -candidateSide
                                float barrierMid = (array.get(zoneTops, j) + array.get(zoneBottoms, j)) / 2.0
                                if candidateSide == 1 and barrierMid > candidateMid and (na(candidateBarrier) or barrierMid < candidateBarrier)
                                    candidateBarrier := barrierMid
                                if candidateSide == -1 and barrierMid < candidateMid and (na(candidateBarrier) or barrierMid > candidateBarrier)
                                    candidateBarrier := barrierMid
                    float roomATR = na(candidateBarrier) ? na : math.abs(candidateBarrier - candidateMid) / math.max(atr, syminfo.mintick)
                    bool hasRoom = na(roomATR) or roomATR >= 1.0
                    if hasRoom and candidateSide == 1 and (na(nearestActionableBullPoi) or candidateDistance < nearestActionableBullDistanceATR)
                        nearestActionableBullPoi := candidateMid
                        nearestActionableBullDistanceATR := candidateDistance
                        bullPoiBarrier := candidateBarrier
                    if hasRoom and candidateSide == -1 and (na(nearestActionableBearPoi) or candidateDistance < nearestActionableBearDistanceATR)
                        nearestActionableBearPoi := candidateMid
                        nearestActionableBearDistanceATR := candidateDistance
                        bearPoiBarrier := candidateBarrier
        actionableBullPoi := not na(nearestActionableBullPoi)
        actionableBearPoi := not na(nearestActionableBearPoi)

        // When no actionable candidate exists, still report the barrier around
        // the nearest qualified POI so the dashboard explains the context.
        if not actionableBullPoi and not na(nearestBullPoi)
            bullPoiBarrier := not na(lastSwingHigh) and lastSwingHigh > nearestBullPoi ? lastSwingHigh : na
        if not actionableBearPoi and not na(nearestBearPoi)
            bearPoiBarrier := not na(lastSwingLow) and lastSwingLow < nearestBearPoi ? lastSwingLow : na
        if not actionableBullPoi or not actionableBearPoi
            for i = 0 to array.size(zones) - 1
                if array.get(zonePoi, i)
                    float barrierMid = (array.get(zoneTops, i) + array.get(zoneBottoms, i)) / 2.0
                    int barrierSide = array.get(zoneSides, i)
                    if not actionableBullPoi and not na(nearestBullPoi) and barrierSide == -1 and barrierMid > nearestBullPoi and (na(bullPoiBarrier) or barrierMid < bullPoiBarrier)
                        bullPoiBarrier := barrierMid
                    if not actionableBearPoi and not na(nearestBearPoi) and barrierSide == 1 and barrierMid < nearestBearPoi and (na(bearPoiBarrier) or barrierMid > bearPoiBarrier)
                        bearPoiBarrier := barrierMid
        string bullState = na(nearestBullPoi) ? "" : actionableBullPoi ? "Bull actionable · " + str.tostring(nearestActionableBullPoi, format.mintick) : "Bull distant/tested"
        string bearState = na(nearestBearPoi) ? "" : actionableBearPoi ? "Bear actionable · " + str.tostring(nearestActionableBearPoi, format.mintick) : "Bear distant/tested"
        poiContextText := bullState + (bullState != "" and bearState != "" ? " · " : "") + bearState
        opposingBarrierText := bias == 1 ? (na(bullPoiBarrier) ? "Bull path open" : "Overhead · " + str.tostring(bullPoiBarrier, format.mintick)) : bias == -1 ? (na(bearPoiBarrier) ? "Bear path open" : "Support · " + str.tostring(bearPoiBarrier, format.mintick)) : "Bias required"

        // Order-block display selection. Order blocks have their own per-side budget and
        // distance limit, independent of POI qualification and of the FVG / supply-demand
        // budget. Hidden blocks keep their analytical state and reappear when they rank in.
        for i = 0 to array.size(zones) - 1
            if array.get(zoneKinds, i) == 1
                array.set(zoneVisible, i, false)
        int obBullShown = 0
        int obBearShown = 0
        if maxVisibleBullOB + maxVisibleBearOB > 0
            for pick = 0 to maxVisibleBullOB + maxVisibleBearOB - 1
                int bestOB = -1
                float bestObScore = -1.0e10
                for i = 0 to array.size(zones) - 1
                    if array.get(zoneKinds, i) == 1 and not array.get(zoneVisible, i)
                        int obSide = array.get(zoneSides, i)
                        float obTop = array.get(zoneTops, i)
                        float obBottom = array.get(zoneBottoms, i)
                        float obDistance = math.abs(close - (obTop + obBottom) / 2.0) / math.max(atr, syminfo.mintick)
                        bool budgetOpen = obSide == 1 ? obBullShown < maxVisibleBullOB : obBearShown < maxVisibleBearOB
                        bool obEligible = budgetOpen and (debugMode or (obDistance <= effObDistanceATR and f_scaleOk((obTop + obBottom) / 2.0)))
                        bool obOverlaps = false
                        if obEligible
                            for j = 0 to array.size(zones) - 1
                                if array.get(zoneVisible, j) and array.get(zoneKinds, j) == 1 and array.get(zoneSides, j) == obSide
                                    float shownTop = array.get(zoneTops, j)
                                    float shownBottom = array.get(zoneBottoms, j)
                                    float shownOverlap = math.min(obTop, shownTop) - math.max(obBottom, shownBottom)
                                    float shownSmaller = math.min(obTop - obBottom, shownTop - shownBottom)
                                    if shownOverlap > 0 and shownSmaller > 0 and shownOverlap / shownSmaller >= 0.5
                                        obOverlaps := true
                        if obEligible and not obOverlaps
                            float obScore = array.get(zoneClasses, i) * 10000.0 + (array.get(zoneTouched, i) ? 0.0 : 5000.0) + (obSide == bias ? 1000.0 : 0.0) + math.max(0.0, 500.0 - obDistance * 10.0) - (bar_index - array.get(zoneBirth, i)) * 0.001
                            if obScore > bestObScore
                                bestOB := i
                                bestObScore := obScore
                if bestOB >= 0
                    array.set(zoneVisible, bestOB, true)
                    if array.get(zoneSides, bestOB) == 1
                        obBullShown += 1
                    else
                        obBearShown += 1
                else
                    break

        // Select the bounded visible set by freshness, bias alignment, proximity,
        // POI confluence, then recency. Overlapping duplicates are suppressed.
        for pick = 0 to effectiveVisibleZones - 1
            int bestIndex = -1
            bool bestPoi = false
            bool bestMissingSide = false
            bool bestFresh = false
            bool bestContext = false
            bool bestAligned = false
            float bestDistance = 1000000.0
            int bestAge = 1000000
            bool hasVisibleBull = false
            bool hasVisibleBear = false
            for visibleIndex = 0 to array.size(zones) - 1
                if array.get(zoneVisible, visibleIndex)
                    hasVisibleBull := hasVisibleBull or array.get(zoneSides, visibleIndex) == 1
                    hasVisibleBear := hasVisibleBear or array.get(zoneSides, visibleIndex) == -1
            for i = 0 to array.size(zones) - 1
                if not array.get(zoneVisible, i)
                    float top = array.get(zoneTops, i)
                    float bottom = array.get(zoneBottoms, i)
                    float zoneMid = (top + bottom) / 2.0
                    float distanceATR = math.abs(close - zoneMid) / math.max(atr, syminfo.mintick)
                    bool eligible = array.get(zoneKinds, i) != 1 and (debugMode or (distanceATR <= effZoneDistanceATR and f_scaleOk(zoneMid)))
                    bool redundant = false
                    if eligible and not debugMode
                        for j = 0 to array.size(zones) - 1
                            if array.get(zoneVisible, j) and array.get(zoneSides, j) == array.get(zoneSides, i)
                                float otherTop = array.get(zoneTops, j)
                                float otherBottom = array.get(zoneBottoms, j)
                                float overlapSize = math.min(top, otherTop) - math.max(bottom, otherBottom)
                                float smallerHeight = math.min(top - bottom, otherTop - otherBottom)
                                if overlapSize > 0 and smallerHeight > 0 and overlapSize / smallerHeight >= 0.60
                                    redundant := true
                    if eligible and not redundant
                        bool fresh = not array.get(zoneTouched, i)
                        bool aligned = array.get(zoneSides, i) == bias
                        bool poi = array.get(zonePoi, i)
                        int candidateSide = array.get(zoneSides, i)
                        bool addsMissingSide = pick > 0 and ((candidateSide == 1 and not hasVisibleBull) or (candidateSide == -1 and not hasVisibleBear))
                        int candidateKind = array.get(zoneKinds, i)
                        bool contextPreferred = (expansionContext and aligned) or (rangeContext and candidateKind == 3) or (transitionContext and poi)
                        int age = bar_index - array.get(zoneBirth, i)
                        bool better = bestIndex < 0 or (poi and not bestPoi) or (poi == bestPoi and addsMissingSide and not bestMissingSide) or (poi == bestPoi and addsMissingSide == bestMissingSide and fresh and not bestFresh) or (poi == bestPoi and addsMissingSide == bestMissingSide and fresh == bestFresh and contextPreferred and not bestContext) or (poi == bestPoi and addsMissingSide == bestMissingSide and fresh == bestFresh and contextPreferred == bestContext and aligned and not bestAligned) or (poi == bestPoi and addsMissingSide == bestMissingSide and fresh == bestFresh and contextPreferred == bestContext and aligned == bestAligned and distanceATR < bestDistance) or (poi == bestPoi and addsMissingSide == bestMissingSide and fresh == bestFresh and contextPreferred == bestContext and aligned == bestAligned and distanceATR == bestDistance and age < bestAge)
                        if better
                            bestIndex := i
                            bestPoi := poi
                            bestMissingSide := addsMissingSide
                            bestFresh := fresh
                            bestContext := contextPreferred
                            bestAligned := aligned
                            bestDistance := distanceATR
                            bestAge := age
            if bestIndex >= 0
                array.set(zoneVisible, bestIndex, true)
            else
                break

        f_renderZones()

        // Visibility audit: every active candidate ends in one deterministic
        // state—visible, outside the distance budget, or hidden by ranking.
        for i = 0 to array.size(zones) - 1
            int auditKind = array.get(zoneKinds, i)
            activeOB += auditKind == 1 ? 1 : 0
            activeFVG += auditKind == 2 ? 1 : 0
            activeSD += auditKind == 3 ? 1 : 0
            visibleOB += auditKind == 1 and array.get(zoneVisible, i) ? 1 : 0
            visibleFVG += auditKind == 2 and array.get(zoneVisible, i) ? 1 : 0
            visibleSD += auditKind == 3 and array.get(zoneVisible, i) ? 1 : 0
            bool auditBase = auditKind == 3 and array.get(zoneClasses, i) == 1
            activeBaseSD += auditBase ? 1 : 0
            visibleBaseSD += auditBase and array.get(zoneVisible, i) ? 1 : 0
            qualifiedPoiCount += array.get(zonePoi, i) ? 1 : 0
            float auditMid = (array.get(zoneTops, i) + array.get(zoneBottoms, i)) / 2.0
            float auditDistance = math.abs(close - auditMid) / math.max(atr, syminfo.mintick)
            bool withinDistance = debugMode or (auditDistance <= (auditKind == 1 ? effObDistanceATR : effZoneDistanceATR) and f_scaleOk(auditMid))
            if not array.get(zoneVisible, i)
                hiddenDistanceCount += withinDistance ? 0 : 1
                hiddenRankingCount += withinDistance ? 1 : 0
            if auditKind == 1
                int auditSide = array.get(zoneSides, i)
                bool auditVisible = array.get(zoneVisible, i)
                activeBullOB += auditSide == 1 ? 1 : 0
                activeBearOB += auditSide == -1 ? 1 : 0
                visibleBullOB += auditVisible and auditSide == 1 ? 1 : 0
                visibleBearOB += auditVisible and auditSide == -1 ? 1 : 0
                string hiddenReason = ""
                if not auditVisible
                    bool overlapsShown = false
                    for j = 0 to array.size(zones) - 1
                        if array.get(zoneVisible, j) and array.get(zoneKinds, j) == 1 and array.get(zoneSides, j) == auditSide
                            float cmpTop = array.get(zoneTops, j)
                            float cmpBottom = array.get(zoneBottoms, j)
                            float cmpOverlap = math.min(array.get(zoneTops, i), cmpTop) - math.max(array.get(zoneBottoms, i), cmpBottom)
                            float cmpSmaller = math.min(array.get(zoneTops, i) - array.get(zoneBottoms, i), cmpTop - cmpBottom)
                            if cmpOverlap > 0 and cmpSmaller > 0 and cmpOverlap / cmpSmaller >= 0.5
                                overlapsShown := true
                    if not withinDistance
                        hiddenOBFar += 1
                        hiddenReason := auditDistance <= effObDistanceATR ? "outside the candle range (scale protection)" : "far (" + str.tostring(auditDistance, "0.0") + " ATR > " + str.tostring(effObDistanceATR, "0") + ")"
                    else if overlapsShown
                        hiddenOBOverlap += 1
                        hiddenReason := "overlaps a higher-ranked OB"
                    else
                        hiddenOBBudget += 1
                        hiddenReason := "per-side budget full"
                int auditOrigin = array.get(zoneOrigins, i)
                string auditSrc = bar_index - auditOrigin <= 790 ? str.format_time(time[bar_index - auditOrigin], "MM-dd HH:mm", syminfo.timezone) : "older"
                array.push(obDebugRows, (auditSide == 1 ? "BULL " : "BEAR ") + (array.get(zoneClasses, i) == 2 ? "swing " : "int ") + array.get(zoneEvents, i) + " · src " + auditSrc + " · " + str.tostring(array.get(zoneBottoms, i), format.mintick) + "-" + str.tostring(array.get(zoneTops, i), format.mintick) + " · " + (array.get(zoneTouched, i) ? "Tested" : "Fresh") + " · " + (auditVisible ? "VISIBLE" : "hidden: " + hiddenReason))

// ------- OPTIONAL CONFIRMED HIGHER-TIMEFRAME CONTEXT -------
// The returned values are shifted by one HTF bar and requested with
// lookahead_on. This exposes only the last completed HTF bar on every chart bar
// and prevents an open HTF candle from changing chart-timeframe decisions.
f_confirmedHtfStructure() =>
    float pivotHigh = ta.pivothigh(high, htfSwingLength, htfSwingLength)
    float pivotLow = ta.pivotlow(low, htfSwingLength, htfSwingLength)
    var float confirmedHigh = na
    var float confirmedLow = na
    var int confirmedBias = 0
    if barstate.isconfirmed and not na(pivotHigh)
        confirmedHigh := pivotHigh
    if barstate.isconfirmed and not na(pivotLow)
        confirmedLow := pivotLow
    if barstate.isconfirmed and not na(confirmedHigh) and close > confirmedHigh
        confirmedBias := 1
    else if barstate.isconfirmed and not na(confirmedLow) and close < confirmedLow
        confirmedBias := -1
    [confirmedHigh[1], confirmedLow[1], confirmedBias[1]]

int selectedHtfSecs = timeframe.in_seconds(htfTimeframe)
bool validHtfSelection = selectedHtfSecs > chartSecs
[confirmedHtfHigh, confirmedHtfLow, confirmedHtfBias] = request.security(syminfo.tickerid, htfTimeframe, f_confirmedHtfStructure(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
string confirmedHtfText = not showHTFContext ? "Off" : not validHtfSelection ? "Select higher TF" : confirmedHtfBias == 1 ? "Bull" : confirmedHtfBias == -1 ? "Bear" : "Neutral"

var line htfHighLine = na
var line htfLowLine = na
var label htfHighTag = na
var label htfLowTag = na
if barstate.islast
    bool renderHtfLevels = showHTFContext and drawHTFLevels and validHtfSelection
    if renderHtfLevels and not na(confirmedHtfHigh)
        int htfLeft = math.max(0, bar_index - htfSwingLength * 2)
        if na(htfHighLine)
            htfHighLine := line.new(htfLeft, confirmedHtfHigh, bar_index + 5, confirmedHtfHigh, xloc = xloc.bar_index, color = color.new(bearColor, 64), style = line.style_dashed, width = 1)
            htfHighTag := label.new(bar_index + 5, confirmedHtfHigh, "HTF H · " + htfTimeframe, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(#090D18, 45), textcolor = color.new(bearColor, 15), size = contextTextSize)
        else
            line.set_xy1(htfHighLine, htfLeft, confirmedHtfHigh)
            line.set_xy2(htfHighLine, bar_index + 5, confirmedHtfHigh)
            label.set_xy(htfHighTag, bar_index + 5, confirmedHtfHigh)
            label.set_text(htfHighTag, "HTF H · " + htfTimeframe)
    else
        if not na(htfHighLine)
            line.delete(htfHighLine)
            htfHighLine := na
        if not na(htfHighTag)
            label.delete(htfHighTag)
            htfHighTag := na
    if renderHtfLevels and not na(confirmedHtfLow)
        int htfLeft = math.max(0, bar_index - htfSwingLength * 2)
        if na(htfLowLine)
            htfLowLine := line.new(htfLeft, confirmedHtfLow, bar_index + 5, confirmedHtfLow, xloc = xloc.bar_index, color = color.new(bullColor, 64), style = line.style_dashed, width = 1)
            htfLowTag := label.new(bar_index + 5, confirmedHtfLow, "HTF L · " + htfTimeframe, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(#090D18, 45), textcolor = color.new(bullColor, 15), size = contextTextSize)
        else
            line.set_xy1(htfLowLine, htfLeft, confirmedHtfLow)
            line.set_xy2(htfLowLine, bar_index + 5, confirmedHtfLow)
            label.set_xy(htfLowTag, bar_index + 5, confirmedHtfLow)
            label.set_text(htfLowTag, "HTF L · " + htfTimeframe)
    else
        if not na(htfLowLine)
            line.delete(htfLowLine)
            htfLowLine := na
        if not na(htfLowTag)
            label.delete(htfLowTag)
            htfLowTag := na

// ------- ASIAN HIGH/LOW -------
// Session state is evaluated natively on <=5m, and inside a 5m security context
// on higher chart TFs. Only COMPLETED sessions are published by this function.
f_asiaSnapshot() =>
    bool inside = not na(time(timeframe.period, asiaSession, asiaTZ))
    bool start = inside and not inside[1]
    bool finish = not inside and inside[1]
    var float workingHigh = na
    var float workingLow = na
    var int workingStart = na
    var float completedHigh = na
    var float completedLow = na
    var int completedStart = na
    if start
        workingHigh := high
        workingLow := low
        workingStart := time
    else if inside
        workingHigh := math.max(nz(workingHigh, high), high)
        workingLow := math.min(nz(workingLow, low), low)
    if finish
        completedHigh := workingHigh
        completedLow := workingLow
        completedStart := workingStart
    [completedHigh, completedLow, completedStart, inside ? workingHigh : na, inside ? workingLow : na]

[nativeAsiaHigh, nativeAsiaLow, nativeAsiaStart, nativeAsiaLiveHigh, nativeAsiaLiveLow] = f_asiaSnapshot()
[fiveAsiaHigh, fiveAsiaLow, fiveAsiaStart, fiveAsiaLiveHigh, fiveAsiaLiveLow] = request.security(syminfo.tickerid, "5", f_asiaSnapshot(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
bool nativeSession = chartSecs <= 300
float asiaHigh = nativeSession ? nativeAsiaHigh : fiveAsiaHigh
float asiaLow = nativeSession ? nativeAsiaLow : fiveAsiaLow
int asiaStart = nativeSession ? nativeAsiaStart : fiveAsiaStart
float asiaLiveHigh = nativeSession ? nativeAsiaLiveHigh : fiveAsiaLiveHigh
float asiaLiveLow = nativeSession ? nativeAsiaLiveLow : fiveAsiaLiveLow
bool newAsianRange = barstate.isconfirmed and not na(asiaStart) and (na(asiaStart[1]) or asiaStart != asiaStart[1])

var line[] asiaHighLines = array.new_line()
var line[] asiaLowLines = array.new_line()

if showAsia and newAsianRange
    int currentEnd = na(time_close) ? time : time_close
    line highLine = line.new(asiaStart, asiaHigh, currentEnd, asiaHigh, xloc = xloc.bar_time, color = color.new(asiaColor, 18), style = line.style_dashed, width = 1)
    line lowLine = line.new(asiaStart, asiaLow, currentEnd, asiaLow, xloc = xloc.bar_time, color = color.new(asiaColor, 32), style = line.style_dashed, width = 1)
    array.push(asiaHighLines, highLine)
    array.push(asiaLowLines, lowLine)
    if array.size(asiaHighLines) > effectiveAsiaHistory
        line.delete(array.shift(asiaHighLines))
        line.delete(array.shift(asiaLowLines))

if showAsia and array.size(asiaHighLines) > 0
    int currentEnd = na(time_close) ? time : time_close
    line.set_x2(array.get(asiaHighLines, array.size(asiaHighLines) - 1), currentEnd)
    line.set_x2(array.get(asiaLowLines, array.size(asiaLowLines) - 1), currentEnd)
    if barstate.islast
        f_regLabel(asiaHigh, "Asia H", asiaColor, 50, "Asian high " + str.tostring(asiaHigh, format.mintick) + " (last completed session)")
        f_regLabel(asiaLow, "Asia L", asiaColor, 50, "Asian low " + str.tostring(asiaLow, format.mintick) + " (last completed session)")

// ------- TRADE PLAN (PRICE-ACTION ENTRY AT A QUALIFIED POI, TARGET AT A KEY LEVEL) -------
// Rules, evaluated only on closed bars:
//  1. Direction follows the external bias (long in a bullish bias, short in a bearish one).
//  2. Zone: an active zone on that side that is a qualified POI (same qualification as the
//     chart), first touched within `Trigger window` bars, not further than `Maximum entry
//     distance` from its edge, and (optionally) on the right side of equilibrium.
//  3. Trigger: the closed bar is a rejection wick or an engulfing candle in the trade direction.
//  4. Entry at that close. Stop beyond the zone's far edge plus a buffer.
//  5. Target: the TECHNICAL level, i.e. the next key level ahead of the entry (default), with the
//     take-profit a small buffer before it so a touch fills. The trade is taken only if that
//     level offers at least the minimum reward : risk; a level that is too close means no trade
//     (the target never jumps over a nearer level). Key levels = active BSL/SSL pools, confirmed
//     swing highs/lows, the Asian high/low, equilibrium and opposing supply/demand/order-block
//     edges. Option "Nearest level with minimum R:R" instead takes the first level that is far enough.
//  6. A zone is spent after one trade; it is never re-entered. One trade at a time. Stop is checked before target on a bar that touches both. A trade
//     that is still open after `Close a trade at market after` bars is closed at that close.
// Results are paper results on closed bars of the loaded history. No orders are sent.
var int tradeDir = 0
var float tradeEntry = na
var float tradeStop = na
var float tradeTarget = na
var int tradeEntryBar = na
var string tradeZoneName = ""
var string tradeTargetName = ""
var box[] tradeProfitBoxes = array.new_box()
var box[] tradeRiskBoxes = array.new_box()
var line[] tradeEntryLines = array.new_line()
var label[] tradeResultLabels = array.new_label()
var float[] tradeResults = array.new_float()
var string[] tradeLog = array.new_string()
var int[] tradeStats = array.new_int(6, 0)   // 0 opened, 1 target, 2 stop, 3 timeout, 4 skipped: no key-level target, 5 skipped: stop outside limits
var float tradeEquityR = 0.0
var float tradePeakR = 0.0
var float tradeMaxDrawdownR = 0.0
var float tradeGrossWinR = 0.0
var float tradeGrossLossR = 0.0
var string[] tradeScratch = array.new_string(1, "")
var int[] tradeSpentBirth = array.new_int()     // zones that already produced a trade (birth bar + top edge)
var float[] tradeSpentTop = array.new_float()
bool tradeLongOpened = false
bool tradeShortOpened = false
bool tradeTargetHit = false
bool tradeStopHit = false

// Technical target for a trade at `entry`: the take-profit price (a buffer before the key level)
// or na when there is no acceptable level; the level's name goes to tradeScratch.
f_keyTarget(bool isLong, float entry, float risk, bool enforceMin) =>
    float[] levels = array.new_float()
    string[] names = array.new_string()
    int poolSide = isLong ? 1 : -1
    if array.size(poolStates) > 0
        for p = 0 to array.size(poolStates) - 1
            if array.get(poolStates, p) == 0 and array.get(poolSides, p) == poolSide
                string poolKind = array.get(poolKinds, p)
                array.push(levels, isLong ? array.get(poolTops, p) : array.get(poolBottoms, p))
                array.push(names, poolKind == "EQ" ? (isLong ? "EQH" : "EQL") : poolKind == "Swing" ? (isLong ? "BSL" : "SSL") : poolKind)
    array.push(levels, isLong ? lastSwingHigh : lastSwingLow)
    array.push(names, isLong ? "Swing high" : "Swing low")
    array.push(levels, isLong ? previousSwingHigh : previousSwingLow)
    array.push(names, isLong ? "Prev swing high" : "Prev swing low")
    array.push(levels, isLong ? asiaHigh : asiaLow)
    array.push(names, isLong ? "Asia H" : "Asia L")
    array.push(levels, not na(lastSwingHigh) and not na(lastSwingLow) ? (lastSwingHigh + lastSwingLow) / 2.0 : na)
    array.push(names, "EQ")
    if array.size(zones) > 0
        for z = 0 to array.size(zones) - 1
            if array.get(zoneKinds, z) != 2 and array.get(zoneSides, z) == -poolSide
                array.push(levels, isLong ? array.get(zoneBottoms, z) : array.get(zoneTops, z))
                array.push(names, array.get(zoneTitles, z))
    float best = na
    float bestRaw = 1.0e10
    float bestAdjusted = 0.0
    string bestName = ""
    float atrNow = nz(atr, syminfo.mintick)
    float buffer = tradeTargetBufferATR * atrNow
    float minDistance = tradeMinRR * risk
    float maxDistance = tradeMaxTargetATR * atrNow
    bool nextOnly = tradeTargetMode == "Next key level" or not enforceMin
    for c = 0 to array.size(levels) - 1
        float level = array.get(levels, c)
        if not na(level)
            float rawDistance = isLong ? level - entry : entry - level
            float adjustedDistance = rawDistance - buffer
            bool qualifies = nextOnly or adjustedDistance >= minDistance
            if rawDistance > 0 and adjustedDistance <= maxDistance and qualifies and rawDistance < bestRaw
                best := isLong ? level - buffer : level + buffer
                bestRaw := rawDistance
                bestAdjusted := adjustedDistance
                bestName := array.get(names, c)
    // Technical-target mode: the next level is the target; if it is too close for the minimum
    // reward : risk there is no trade (a farther level would sit behind it).
    if enforceMin and nextOnly and not na(best) and bestAdjusted < minDistance
        best := na
    array.set(tradeScratch, 0, bestName)
    best

f_tradeResultText(float r) =>
    (r >= 0 ? "+" : "−") + str.tostring(math.abs(r), "0.0") + "R"

// Planned RR box: the long/short position tool for the nearest qualified POI on the bias side,
// drawn before any trigger so the box is always visible. Entry = the zone's near edge, stop beyond
// the far edge, take-profit at the next key level (shown even when its R:R is below the trade
// minimum). It disappears while a real trade is open and is redrawn on the last bar only.
var box[] tradePreviewBoxes = array.new_box()
var line[] tradePreviewLines = array.new_line()

f_renderTradePreview() =>
    while array.size(tradePreviewBoxes) > 0
        box.delete(array.pop(tradePreviewBoxes))
    while array.size(tradePreviewLines) > 0
        line.delete(array.pop(tradePreviewLines))
    if showTradePlan and showTradePreview and tradeDir == 0 and bias != 0 and not na(atr) and array.size(zones) > 0
        bool isLong = bias == 1
        float eqLevel = not na(lastSwingHigh) and not na(lastSwingLow) ? (lastSwingHigh + lastSwingLow) / 2.0 : na
        int pickZone = -1
        float bestGap = 1.0e10
        for z = 0 to array.size(zones) - 1
            int zoneKind = array.get(zoneKinds, z)
            bool kindAllowed = tradeZoneKinds == "All qualified POIs" or (tradeZoneKinds == "Order blocks and supply/demand" and zoneKind != 2) or (tradeZoneKinds == "Order blocks only" and zoneKind == 1)
            bool zoneSpent = false
            if array.size(tradeSpentBirth) > 0
                for q = 0 to array.size(tradeSpentBirth) - 1
                    if array.get(tradeSpentBirth, q) == array.get(zoneBirth, z) and array.get(tradeSpentTop, q) == array.get(zoneTops, z)
                        zoneSpent := true
            if kindAllowed and not zoneSpent and array.get(zoneSides, z) == bias
                float zTop = array.get(zoneTops, z)
                float zBottom = array.get(zoneBottoms, z)
                float zMid = (zTop + zBottom) / 2.0
                float edge = isLong ? zTop : zBottom
                float gap = math.abs(close - edge)
                bool rightSide = isLong ? zMid <= close : zMid >= close
                bool pdOk = not tradeRequirePD or na(eqLevel) or (isLong ? zMid <= eqLevel : zMid >= eqLevel)
                if rightSide and pdOk and gap < bestGap and gap <= zoneDisplayDistanceATR * atr and f_scaleOk(edge) and f_poiPath(z, not array.get(zoneTouched, z)) != "Candidate"
                    pickZone := z
                    bestGap := gap
        if pickZone >= 0
            float pTop = array.get(zoneTops, pickZone)
            float pBottom = array.get(zoneBottoms, pickZone)
            float entryPrice = isLong ? pTop : pBottom
            float stopPrice = isLong ? pBottom - tradeStopBufferATR * atr : pTop + tradeStopBufferATR * atr
            float riskDistance = math.abs(entryPrice - stopPrice)
            if riskDistance >= tradeMinStopATR * atr and riskDistance <= tradeMaxStopATR * atr
                float targetPrice = f_keyTarget(isLong, entryPrice, riskDistance, false)
                if not na(targetPrice)
                    float rr = math.abs(targetPrice - entryPrice) / riskDistance
                    int leftBar = bar_index
                    int rightBar = bar_index + 14
                    box profitBox = box.new(left = leftBar, top = isLong ? targetPrice : entryPrice, right = rightBar, bottom = isLong ? entryPrice : targetPrice, xloc = xloc.bar_index, border_color = color.new(tradeProfitColor, 55), border_style = line.style_dashed, bgcolor = color.new(tradeProfitColor, 86), text = "plan " + str.tostring(rr, "0.0") + "R", text_color = color.new(color.white, 15), text_size = size.small, text_halign = text.align_left, text_valign = isLong ? text.align_top : text.align_bottom)
                    box riskBox = box.new(left = leftBar, top = isLong ? entryPrice : stopPrice, right = rightBar, bottom = isLong ? stopPrice : entryPrice, xloc = xloc.bar_index, border_color = color.new(tradeRiskColor, 55), border_style = line.style_dashed, bgcolor = color.new(tradeRiskColor, 86))
                    line entryLine = line.new(leftBar, entryPrice, rightBar, entryPrice, xloc = xloc.bar_index, color = color.new(color.white, 45), style = line.style_dashed, width = 1)
                    array.push(tradePreviewBoxes, profitBox)
                    array.push(tradePreviewBoxes, riskBox)
                    array.push(tradePreviewLines, entryLine)
    0

if showTradePlan and barstate.isconfirmed and not na(atr) and bar_index > 40
    bool closedNow = false
    // 1) Follow the open trade.
    if tradeDir != 0 and bar_index > tradeEntryBar
        bool isLongOpen = tradeDir == 1
        float riskOpen = math.abs(tradeEntry - tradeStop)
        bool stopTouched = isLongOpen ? low <= tradeStop : high >= tradeStop
        bool targetTouched = isLongOpen ? high >= tradeTarget : low <= tradeTarget
        bool timedOut = bar_index - tradeEntryBar >= tradeTimeoutBars
        string outcome = ""
        float exitPrice = na
        if stopTouched
            outcome := "SL"
            exitPrice := isLongOpen ? math.min(tradeStop, open) : math.max(tradeStop, open)
        else if targetTouched
            outcome := "TP"
            exitPrice := tradeTarget
        else if timedOut
            outcome := "TIME"
            exitPrice := close
        int lastBox = array.size(tradeProfitBoxes) - 1
        if outcome == ""
            box.set_right(array.get(tradeProfitBoxes, lastBox), bar_index)
            box.set_right(array.get(tradeRiskBoxes, lastBox), bar_index)
            line.set_x2(array.get(tradeEntryLines, lastBox), bar_index)
        else
            float resultR = (isLongOpen ? exitPrice - tradeEntry : tradeEntry - exitPrice) / riskOpen - tradeCost / riskOpen
            closedNow := true
            tradeTargetHit := outcome == "TP"
            tradeStopHit := outcome == "SL"
            array.push(tradeResults, resultR)
            f_inc(tradeStats, outcome == "TP" ? 1 : outcome == "SL" ? 2 : 3)
            tradeEquityR += resultR
            tradePeakR := math.max(tradePeakR, tradeEquityR)
            tradeMaxDrawdownR := math.max(tradeMaxDrawdownR, tradePeakR - tradeEquityR)
            tradeGrossWinR += resultR > 0 ? resultR : 0.0
            tradeGrossLossR += resultR < 0 ? -resultR : 0.0
            array.push(tradeLog, str.format_time(bar_index - tradeEntryBar <= 790 ? time[bar_index - tradeEntryBar] : time, "MM-dd HH:mm", syminfo.timezone) + " " + (isLongOpen ? "LONG " : "SHORT ") + str.tostring(tradeEntry, format.mintick) + " → " + outcome + " " + f_tradeResultText(resultR) + " · " + tradeZoneName + " → " + tradeTargetName)
            if array.size(tradeLog) > 12
                array.shift(tradeLog)
            box finishedProfit = array.get(tradeProfitBoxes, lastBox)
            box finishedRisk = array.get(tradeRiskBoxes, lastBox)
            box.set_right(finishedProfit, bar_index)
            box.set_right(finishedRisk, bar_index)
            box.set_bgcolor(finishedProfit, color.new(tradeProfitColor, 90))
            box.set_bgcolor(finishedRisk, color.new(tradeRiskColor, 90))
            line.set_x2(array.get(tradeEntryLines, lastBox), bar_index)
            float labelPrice = outcome == "TIME" ? exitPrice : outcome == "TP" ? tradeTarget : tradeStop
            bool labelAbove = (outcome == "TP" and isLongOpen) or (outcome == "SL" and not isLongOpen)
            label resultLabel = label.new(bar_index, labelPrice, f_tradeResultText(resultR) + (outcome == "TIME" ? " time" : ""), xloc = xloc.bar_index, yloc = yloc.price, style = outcome == "TIME" ? label.style_label_center : labelAbove ? label.style_label_down : label.style_label_up, color = color.new(#090D18, 15), textcolor = resultR > 0 ? tradeProfitColor : tradeRiskColor, size = contextTextSize)
            array.set(tradeResultLabels, lastBox, resultLabel)
            tradeDir := 0
    // 2) Look for a new setup.
    if tradeDir == 0 and not closedNow and bias != 0 and array.size(zones) > 0
        bool isLong = bias == 1
        float rng = high - low
        float wickLow = math.min(open, close) - low
        float wickHigh = high - math.max(open, close)
        bool rejection = rng > 0 and (isLong ? (close > open and wickLow >= tradeWickFrac * rng) : (close < open and wickHigh >= tradeWickFrac * rng))
        bool engulfing = isLong ? (close[1] < open[1] and close > open and close > open[1] and open <= close[1]) : (close[1] > open[1] and close < open and close < open[1] and open >= close[1])
        bool triggered = tradeTrigger == "Rejection wick" ? rejection : tradeTrigger == "Engulfing" ? engulfing : (rejection or engulfing)
        if triggered
            float eqLevel = not na(lastSwingHigh) and not na(lastSwingLow) ? (lastSwingHigh + lastSwingLow) / 2.0 : na
            float bestRR = 0.0
            int pickZone = -1
            float pickStop = na
            float pickTarget = na
            string pickTargetName = ""
            bool sawNoTarget = false
            bool sawBadStop = false
            for z = 0 to array.size(zones) - 1
                int zoneKind = array.get(zoneKinds, z)
                bool kindAllowed = tradeZoneKinds == "All qualified POIs" or (tradeZoneKinds == "Order blocks and supply/demand" and zoneKind != 2) or (tradeZoneKinds == "Order blocks only" and zoneKind == 1)
                int firstTouch = array.get(zoneFirstTouch, z)
                bool zoneSpent = false
                if array.size(tradeSpentBirth) > 0
                    for q = 0 to array.size(tradeSpentBirth) - 1
                        if array.get(tradeSpentBirth, q) == array.get(zoneBirth, z) and array.get(tradeSpentTop, q) == array.get(zoneTops, z)
                            zoneSpent := true
                if kindAllowed and not zoneSpent and array.get(zoneSides, z) == bias and bar_index > array.get(zoneBirth, z) and firstTouch >= 0 and bar_index - firstTouch <= tradeTriggerBars
                    float zTop = array.get(zoneTops, z)
                    float zBottom = array.get(zoneBottoms, z)
                    float zMid = (zTop + zBottom) / 2.0
                    bool nearZone = isLong ? close - zTop <= tradeChaseATR * atr : zBottom - close <= tradeChaseATR * atr
                    bool onZoneSide = isLong ? close > zBottom : close < zTop
                    bool pdOk = not tradeRequirePD or na(eqLevel) or (isLong ? zMid <= eqLevel : zMid >= eqLevel)
                    if nearZone and onZoneSide and pdOk and f_poiPath(z, true) != "Candidate"
                        float stopPrice = isLong ? zBottom - tradeStopBufferATR * atr : zTop + tradeStopBufferATR * atr
                        float riskDistance = math.abs(close - stopPrice)
                        if riskDistance >= tradeMinStopATR * atr and riskDistance <= tradeMaxStopATR * atr
                            float targetPrice = f_keyTarget(isLong, close, riskDistance, true)
                            if na(targetPrice)
                                sawNoTarget := true
                            else
                                float rr = math.abs(targetPrice - close) / riskDistance
                                if rr > bestRR
                                    bestRR := rr
                                    pickZone := z
                                    pickStop := stopPrice
                                    pickTarget := targetPrice
                                    pickTargetName := array.get(tradeScratch, 0)
                        else
                            sawBadStop := true
            if pickZone < 0
                if sawNoTarget
                    f_inc(tradeStats, 4)
                else if sawBadStop
                    f_inc(tradeStats, 5)
            else
                tradeDir := bias
                tradeEntry := close
                tradeStop := pickStop
                tradeTarget := pickTarget
                tradeEntryBar := bar_index
                tradeZoneName := array.get(zoneTitles, pickZone)
                array.push(tradeSpentBirth, array.get(zoneBirth, pickZone))
                array.push(tradeSpentTop, array.get(zoneTops, pickZone))
                if array.size(tradeSpentBirth) > 200
                    array.shift(tradeSpentBirth)
                    array.shift(tradeSpentTop)
                tradeTargetName := pickTargetName
                tradeLongOpened := isLong
                tradeShortOpened := not isLong
                f_inc(tradeStats, 0)
                string planText = str.tostring(bestRR, "0.0") + "R"
                box profitBox = box.new(left = bar_index, top = isLong ? tradeTarget : tradeEntry, right = bar_index + 1, bottom = isLong ? tradeEntry : tradeTarget, xloc = xloc.bar_index, border_color = color.new(tradeProfitColor, 100), bgcolor = color.new(tradeProfitColor, 80), text = planText, text_color = color.new(color.white, 15), text_size = size.small, text_halign = text.align_left, text_valign = isLong ? text.align_top : text.align_bottom)
                box riskBox = box.new(left = bar_index, top = isLong ? tradeEntry : tradeStop, right = bar_index + 1, bottom = isLong ? tradeStop : tradeEntry, xloc = xloc.bar_index, border_color = color.new(tradeRiskColor, 100), bgcolor = color.new(tradeRiskColor, 80))
                line entryLine = line.new(bar_index, tradeEntry, bar_index + 1, tradeEntry, xloc = xloc.bar_index, color = color.new(color.white, 35), style = line.style_solid, width = 1)
                label emptyResult = na
                array.push(tradeProfitBoxes, profitBox)
                array.push(tradeRiskBoxes, riskBox)
                array.push(tradeEntryLines, entryLine)
                array.push(tradeResultLabels, emptyResult)
                // Only the most recent trades stay on the chart; statistics keep counting all of them.
                while array.size(tradeProfitBoxes) > tradeHistory
                    box.delete(array.shift(tradeProfitBoxes))
                    box.delete(array.shift(tradeRiskBoxes))
                    line.delete(array.shift(tradeEntryLines))
                    label oldResult = array.shift(tradeResultLabels)
                    if not na(oldResult)
                        label.delete(oldResult)

if barstate.islast
    f_renderTradePreview()

if barstate.islast and tradeDir != 0
    string tradeSide = tradeDir == 1 ? "LONG" : "SHORT"
    f_regLabel(tradeTarget, "TP", tradeProfitColor, 95, tradeSide + " target " + str.tostring(tradeTarget, format.mintick) + " · " + tradeTargetName)
    f_regLabel(tradeEntry, "ENTRY", color.new(color.white, 10), 90, tradeSide + " entry " + str.tostring(tradeEntry, format.mintick) + " · " + tradeZoneName)
    f_regLabel(tradeStop, "SL", tradeRiskColor, 95, tradeSide + " stop " + str.tostring(tradeStop, format.mintick))

// ------- NEAREST UNSWEPT INTERNAL SWING HIGH / LOW (iBSL / iSSL) -------
// A confirmed pool needs an external swing or two independent tests, so in a clean trend
// the obvious recent highs/lows are not pools. These two lines mark only the nearest
// internal swing high above and low below price that no later bar has traded through and
// that is not already a pool. They are drawn markers, not pools: no state, no alerts.
var line nearIntBslLine = na
var line nearIntSslLine = na
if barstate.islast
    int pickBsl = -1
    int pickSsl = -1
    float gapBsl = 1.0e10
    float gapSsl = 1.0e10
    float safeAtr = math.max(nz(atr, syminfo.mintick), syminfo.mintick)
    if showNearestInternal and not minimalMode and not na(atr) and array.size(ringPrices) > 0
        for r = 0 to array.size(ringPrices) - 1
            float rp = array.get(ringPrices, r)
            int rb = array.get(ringBars, r)
            int rs = array.get(ringSides, r)
            bool onSide = (rs == 1 and rp > close) or (rs == -1 and rp < close)
            float gap = math.abs(rp - close)
            bool nearer = rs == 1 ? gap < gapBsl : gap < gapSsl
            if onSide and nearer and f_scaleOk(rp) and bar_index - rb >= 1 and bar_index - rb <= 750
                bool intact = true
                for k = 0 to bar_index - rb - 1
                    if intact and (rs == 1 ? high[k] > rp : low[k] < rp)
                        intact := false
                if intact and array.size(poolStates) > 0
                    for q = 0 to array.size(poolStates) - 1
                        float poolEdge = array.get(poolSides, q) == 1 ? array.get(poolTops, q) : array.get(poolBottoms, q)
                        if array.get(poolSides, q) == rs and array.get(poolStates, q) == 0 and math.abs(poolEdge - rp) <= safeAtr * 0.5
                            intact := false
                if intact
                    if rs == 1
                        pickBsl := r
                        gapBsl := gap
                    else
                        pickSsl := r
                        gapSsl := gap
    if pickBsl >= 0
        float bslPrice = array.get(ringPrices, pickBsl)
        int bslLeft = math.max(array.get(ringBars, pickBsl), bar_index - maxDrawBars)
        if na(nearIntBslLine)
            nearIntBslLine := line.new(bslLeft, bslPrice, bar_index + 5, bslPrice, xloc = xloc.bar_index, color = color.new(liquidityColor, 55), style = line.style_dashed, width = 1)
        else
            line.set_xy1(nearIntBslLine, bslLeft, bslPrice)
            line.set_xy2(nearIntBslLine, bar_index + 5, bslPrice)
        f_regLabel(bslPrice, "iBSL", liquidityColor, 40, "iBSL " + str.tostring(bslPrice, format.mintick) + " · nearest unswept internal swing high above price (" + str.tostring(gapBsl / safeAtr, "0.0") + " ATR). A marker, not a confirmed pool.")
    else if not na(nearIntBslLine)
        line.delete(nearIntBslLine)
        nearIntBslLine := na
    if pickSsl >= 0
        float sslPrice = array.get(ringPrices, pickSsl)
        int sslLeft = math.max(array.get(ringBars, pickSsl), bar_index - maxDrawBars)
        if na(nearIntSslLine)
            nearIntSslLine := line.new(sslLeft, sslPrice, bar_index + 5, sslPrice, xloc = xloc.bar_index, color = color.new(liquidityColor, 55), style = line.style_dashed, width = 1)
        else
            line.set_xy1(nearIntSslLine, sslLeft, sslPrice)
            line.set_xy2(nearIntSslLine, bar_index + 5, sslPrice)
        f_regLabel(sslPrice, "iSSL", liquidityColor, 40, "iSSL " + str.tostring(sslPrice, format.mintick) + " · nearest unswept internal swing low below price (" + str.tostring(gapSsl / safeAtr, "0.0") + " ATR). A marker, not a confirmed pool.")
    else if not na(nearIntSslLine)
        line.delete(nearIntSslLine)
        nearIntSslLine := na

// ------- PREMIUM / DISCOUNT (EQUILIBRIUM OF THE CONFIRMED EXTERNAL RANGE) -------
// Premium = upper half of the last confirmed external high-low range (supply side),
// discount = lower half (demand side); the dashed line is equilibrium (50%). The two halves
// are drawn as a slim gauge at the right edge, not as full-width fills, so the candles stay
// clear. Clipped to the candle-scale window / candle range like every other object.
var box pdPremiumBox = na
var box pdDiscountBox = na
var line pdEqLine = na
if barstate.islast
    bool pdValid = showPremiumDiscount and not minimalMode and not na(lastSwingHigh) and not na(lastSwingLow) and not na(lastHighBar) and not na(lastLowBar) and not na(atr) and lastSwingHigh > lastSwingLow
    float pdMid = pdValid ? (lastSwingHigh + lastSwingLow) / 2.0 : na
    float pdWindow = protectCandleScale ? scaleWindowATR * nz(atr, syminfo.mintick) : 1.0e10
    float pdTop = pdValid ? math.min(lastSwingHigh, math.max(close + pdWindow, scaleBandHigh + nz(atr, 0.0))) : na
    float pdBottom = pdValid ? math.max(lastSwingLow, math.min(close - pdWindow, scaleBandLow - nz(atr, 0.0))) : na
    int pdLeft = pdValid ? math.max(math.min(lastHighBar, lastLowBar), bar_index - maxDrawBars) : bar_index
    float premiumLow = pdValid ? math.max(pdMid, pdBottom) : na
    float discountHigh = pdValid ? math.min(pdMid, pdTop) : na
    bool premiumShown = pdValid and pdTop > premiumLow
    bool discountShown = pdValid and discountHigh > pdBottom
    bool eqShown = pdValid and pdMid >= pdBottom and pdMid <= pdTop
    int gaugeLeft = bar_index - 4
    if premiumShown
        if na(pdPremiumBox)
            pdPremiumBox := box.new(left = gaugeLeft, top = pdTop, right = bar_index + 5, bottom = premiumLow, xloc = xloc.bar_index, border_color = color.new(supplyColor, 100), bgcolor = color.new(supplyColor, 90))
        else
            box.set_lefttop(pdPremiumBox, gaugeLeft, pdTop)
            box.set_rightbottom(pdPremiumBox, bar_index + 5, premiumLow)
        f_regLabel(premiumLow + (pdTop - premiumLow) * 0.8, "PREMIUM", supplyColor, 15, "Upper half of the confirmed external range: supply side")
    else if not na(pdPremiumBox)
        box.delete(pdPremiumBox)
        pdPremiumBox := na
    if discountShown
        if na(pdDiscountBox)
            pdDiscountBox := box.new(left = gaugeLeft, top = discountHigh, right = bar_index + 5, bottom = pdBottom, xloc = xloc.bar_index, border_color = color.new(demandColor, 100), bgcolor = color.new(demandColor, 90))
        else
            box.set_lefttop(pdDiscountBox, gaugeLeft, discountHigh)
            box.set_rightbottom(pdDiscountBox, bar_index + 5, pdBottom)
        f_regLabel(pdBottom + (discountHigh - pdBottom) * 0.2, "DISCOUNT", demandColor, 15, "Lower half of the confirmed external range: demand side")
    else if not na(pdDiscountBox)
        box.delete(pdDiscountBox)
        pdDiscountBox := na
    if eqShown
        if na(pdEqLine)
            pdEqLine := line.new(pdLeft, pdMid, bar_index + 5, pdMid, xloc = xloc.bar_index, color = color.new(liquidityColor, 62), style = line.style_dashed, width = 1)
        else
            line.set_xy1(pdEqLine, pdLeft, pdMid)
            line.set_xy2(pdEqLine, bar_index + 5, pdMid)
        f_regLabel(pdMid, "EQ " + str.tostring(pdMid, format.mintick), liquidityColor, 35, "Equilibrium: 50% of the confirmed external range")
    else if not na(pdEqLine)
        line.delete(pdEqLine)
        pdEqLine := na

// ------- RIGHT-EDGE LABEL COLUMN (ONE LABEL PER PRICE CLUSTER) -------
var label[] colLabels = array.new_label()

// Merge the registered labels of one cluster into a single label in column slot `slot`.
f_emitCluster(int[] members, int slot) =>
    int m = array.size(members)
    float[] prio = array.new_float()
    for q = 0 to m - 1
        array.push(prio, array.get(rlPriority, array.get(members, q)) * 1.0)
    int[] ranking = array.sort_indices(prio, order.descending)
    int top = array.get(members, array.get(ranking, 0))
    int shown = math.min(m, 3)
    string caption = ""
    string tip = ""
    for q = 0 to m - 1
        int idx = array.get(members, array.get(ranking, q))
        if q < shown
            caption += (q > 0 ? " · " : "") + array.get(rlText, idx)
        tip += (q > 0 ? "\n" : "") + array.get(rlTip, idx)
    if m > shown
        caption += " +" + str.tostring(m - shown)
    float y = array.get(rlY, top)
    color tone = array.get(rlTone, top)
    if slot >= array.size(colLabels)
        label made = label.new(bar_index + 7, y, caption, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(#090D18, 35), textcolor = tone, size = contextTextSize, tooltip = tip)
        array.push(colLabels, made)
    else
        label existing = array.get(colLabels, slot)
        label.set_xy(existing, bar_index + 7, y)
        label.set_text(existing, caption)
        label.set_textcolor(existing, tone)
        label.set_tooltip(existing, tip)
    slot + 1

if barstate.islast
    // Levels that are not owned by another block are registered here.
    if showMajorLevels and not na(activeProtected)
        f_regLabel(activeProtected, "PROTECTED", protectedTone, 80, "Protected level " + str.tostring(activeProtected, format.mintick) + ": the external level whose break flips the bias")
    if showMajorLevels and developingDirection != 0
        float devPrice = developingDirection == 1 ? developingHigh : developingLow
        f_regLabel(devPrice, developingDirection == 1 ? "DEV HIGH" : "DEV LOW", developingDirection == 1 ? bullColor : bearColor, 70, "Live extreme of the current directional leg " + str.tostring(devPrice, format.mintick) + "; not yet a confirmed major swing")
    int slotsUsed = 0
    int regCount = array.size(rlY)
    if regCount > 0
        int[] byPrice = array.sort_indices(rlY, order.descending)
        // Labels closer than this merge: at least the annotation spacing, and about one label
        // height (~1/48 of the candle range the chart already shows) so the merge rule follows the zoom.
        float clusterGap = math.max(annotationATRSpacing * nz(atr, syminfo.mintick), (scaleBandHigh - scaleBandLow) / 48.0)
        int[] members = array.new_int()
        float previousY = na
        for r = 0 to regCount - 1
            int idx = array.get(byPrice, r)
            float y = array.get(rlY, idx)
            if array.size(members) > 0 and previousY - y >= clusterGap
                slotsUsed := f_emitCluster(members, slotsUsed)
                array.clear(members)
            array.push(members, idx)
            previousY := y
        if array.size(members) > 0
            slotsUsed := f_emitCluster(members, slotsUsed)
    while array.size(colLabels) > slotsUsed
        label.delete(array.pop(colLabels))

// Wall-clock age (weekends and market closures count) of an event time.
f_age(int fromTime) =>
    string out = "—"
    if not na(fromTime)
        int mins = math.max(0, int((time - fromTime) / 60000))
        out := mins >= 1440 ? str.tostring(int(mins / 1440)) + "d " + str.tostring(int((mins % 1440) / 60)) + "h" : mins >= 60 ? str.tostring(int(mins / 60)) + "h " + str.tostring(mins % 60) + "m" : str.tostring(mins) + "m"
    out

// ------- DASHBOARD v2 / MARKET INTELLIGENCE -------
var table dashboard = table.new(dashboardPosition, 2, 28, bgcolor = color.new(#090D18, 7), frame_color = color.new(#B48AFF, 30), frame_width = 1, border_color = color.new(#493D64, 75), border_width = 1)
if barstate.isfirst
    table.merge_cells(dashboard, 0, 1, 1, 1)
    table.merge_cells(dashboard, 0, 5, 1, 5)
    table.merge_cells(dashboard, 0, 12, 1, 12)
    table.merge_cells(dashboard, 0, 17, 1, 17)
    table.merge_cells(dashboard, 0, 21, 1, 21)

// Panel drawing is a function so the main script body stays within TradingView's size limit.
f_renderPanel() =>
    table.clear(dashboard, 0, 0, 1, 27)
    if showDashboard
        color valueColor = bias == 1 ? bullColor : bias == -1 ? bearColor : color.silver
        string biasText = bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "NEUTRAL"
        string phaseText = transitionContext ? "Structural transition" : expansionContext ? (bias == 1 ? "Bull expansion" : "Bear expansion") : developingDirection == -bias and bias != 0 ? (bias == -1 ? "Counter-trend rebound" : "Counter-trend pullback") : rangeContext ? "Range / consolidation" : bias == 0 ? "Range / discovery" : internalBias == -bias ? "Corrective pullback" : "Trend / balance"
        float majorMid = not na(lastSwingHigh) and not na(lastSwingLow) ? (lastSwingHigh + lastSwingLow) / 2.0 : na
        string rangeText = na(majorMid) ? "Range pending" : close > lastSwingHigh ? "Above range" : close < lastSwingLow ? "Below range" : close >= majorMid ? "Premium" : "Discount"
        string highText = na(lastSwingHigh) ? "—" : str.tostring(lastSwingHigh, format.mintick)
        string lowText = na(lastSwingLow) ? "—" : str.tostring(lastSwingLow, format.mintick)
        string developingText = developingDirection == 1 and not na(developingHigh) ? "High · " + str.tostring(developingHigh, format.mintick) : developingDirection == -1 and not na(developingLow) ? "Low · " + str.tostring(developingLow, format.mintick) : "—"
        string legText = developingDirection == 1 ? "UP · " + rangeText : developingDirection == -1 ? "DOWN · " + rangeText : "UNDEFINED"
        string protectedText = bias == 1 ? (na(protectedLow) ? "—" : "Low · " + str.tostring(protectedLow, format.mintick)) : bias == -1 ? (na(protectedHigh) ? "—" : "High · " + str.tostring(protectedHigh, format.mintick)) : "—"
        string zoneText = "OB " + str.tostring(visibleOB) + "/" + str.tostring(activeOB) + "  FVG " + str.tostring(visibleFVG) + "/" + str.tostring(activeFVG) + "  S/D " + str.tostring(visibleSD) + "/" + str.tostring(activeSD) + " (base " + str.tostring(visibleBaseSD) + "/" + str.tostring(activeBaseSD) + ")"
        string liquidityText = (nearestBslShown and nearestSslShown) or (na(nearestBslPrice) and na(nearestSslPrice)) ? "" : "* nearest pool is active but not drawn (beyond the candle-scale window, hidden by profile, or over budget)\n"
        liquidityText += (na(nearestBslPrice) ? "" : "Nearest BSL " + str.tostring(nearestBslPrice, format.mintick) + " (" + str.tostring((nearestBslPrice - close) / math.max(atr, syminfo.mintick), "0.0") + " ATR)\n") + (na(nearestSslPrice) ? "" : "Nearest SSL " + str.tostring(nearestSslPrice, format.mintick) + " (" + str.tostring((close - nearestSslPrice) / math.max(atr, syminfo.mintick), "0.0") + " ATR)\n")
        liquidityText += str.tostring(relevantLiquidityCount) + " shown · " + str.tostring(poolActiveCount) + " active · " + str.tostring(poolSweptCount) + " swept · " + str.tostring(poolConsumedCount) + " consumed · " + lastSweep
        int hiddenOBTotal = hiddenOBFar + hiddenOBOverlap + hiddenOBBudget
        string obLastText = array.get(obLastOutcome, 0)
        string obShortText = str.length(obLastText) > 34 ? str.substring(obLastText, 0, 34) + "…" : obLastText
        string obSummary = activeOB == 0 ? "none active · " + obShortText : "Bull " + str.tostring(visibleBullOB) + "/" + str.tostring(activeBullOB) + " · Bear " + str.tostring(visibleBearOB) + "/" + str.tostring(activeBearOB) + (hiddenOBTotal > 0 ? " · hid " + str.tostring(hiddenOBTotal) : "")
        string obTooltip = "Visible / active. Hidden: far " + str.tostring(hiddenOBFar) + " · overlap " + str.tostring(hiddenOBOverlap) + " · budget " + str.tostring(hiddenOBBudget) + "\nAccepted " + str.tostring(array.get(obStats, 0)) + " · rejected " + str.tostring(array.get(obStats, 1)) + " · replaced " + str.tostring(array.get(obStats, 2)) + " · covered " + str.tostring(array.get(obStats, 3)) + "\nMitigated " + str.tostring(array.get(obStats, 4)) + " · invalidated " + str.tostring(array.get(obStats, 5)) + " · aged " + str.tostring(array.get(obStats, 6)) + " · evicted " + str.tostring(array.get(obStats, 7)) + "\n" + obLastText
        string sdLastText = array.get(sdLastOutcome, 0)
        string sdSummary = "Swing " + str.tostring(activeSD - activeBaseSD) + " · Base " + str.tostring(visibleBaseSD) + "/" + str.tostring(activeBaseSD)
        string sdTooltip = "Base-and-impulse zones visible / active\nAccepted " + str.tostring(array.get(sdStats, 0)) + " · duplicate " + str.tostring(array.get(sdStats, 5)) + " · retired by cap " + str.tostring(array.get(sdStats, 6)) + "\nRejected: weak departure " + str.tostring(array.get(sdStats, 1)) + " · no impulse " + str.tostring(array.get(sdStats, 2)) + " · closed back " + str.tostring(array.get(sdStats, 3)) + " · pattern filter " + str.tostring(array.get(sdStats, 4)) + "\n" + sdLastText
        string liqRowText = (na(nearestBslPrice) ? "BSL —" : "BSL " + str.tostring(nearestBslPrice, format.mintick) + (nearestBslShown ? "" : "*")) + " · " + (na(nearestSslPrice) ? "SSL —" : "SSL " + str.tostring(nearestSslPrice, format.mintick) + (nearestSslShown ? "" : "*"))
        string asiaHighText = na(asiaHigh) ? "Waiting for close" : str.tostring(asiaHigh, format.mintick)
        string asiaLowText = na(asiaLow) ? "Waiting for close" : str.tostring(asiaLow, format.mintick)
        string auditText = "POI " + str.tostring(qualifiedPoiCount) + " · far " + str.tostring(hiddenDistanceCount) + " · ranked " + str.tostring(hiddenRankingCount) + " · retired " + str.tostring(invalidatedZoneCount + agedZoneCount) + " · filter O/F/S " + str.tostring(array.get(obStats, 1)) + "/" + str.tostring(rejectedFVGCount) + "/" + str.tostring(rejectedSDCount)
        string auditShort = "POI " + str.tostring(qualifiedPoiCount) + " · hidden " + str.tostring(hiddenDistanceCount + hiddenRankingCount) + " · retired " + str.tostring(invalidatedZoneCount + agedZoneCount)
        bool compactPanel = dashboardDensity == "Compact"
        bool expandedPanel = dashboardDensity == "Expanded"
        string htfBiasSuffix = showHTFContext ? " · HTF " + confirmedHtfText : ""
        bool nearestBullIsActionable = actionableBullPoi and math.abs(nearestBullPoi - nearestActionableBullPoi) <= syminfo.mintick
        bool nearestBearIsActionable = actionableBearPoi and math.abs(nearestBearPoi - nearestActionableBearPoi) <= syminfo.mintick
        string bullPoiDisplay = na(nearestBullPoi) ? "—" : compactPanel ? str.tostring(nearestBullPoi, format.mintick) + " · " + str.tostring(nearestBullPoiDistanceATR, "#.0") + (nearestBullIsActionable ? "A" : actionableBullPoi ? "Q" : "D") : nearestBullPoiText
        string bearPoiDisplay = na(nearestBearPoi) ? "—" : compactPanel ? str.tostring(nearestBearPoi, format.mintick) + " · " + str.tostring(nearestBearPoiDistanceATR, "#.0") + (nearestBearIsActionable ? "A" : actionableBearPoi ? "Q" : "D") : nearestBearPoiText
        string poiStatusDisplay = compactPanel ? (na(nearestBullPoi) ? "" : actionableBullPoi ? "B:A" : "B:D") + (not na(nearestBullPoi) and not na(nearestBearPoi) ? " · " : "") + (na(nearestBearPoi) ? "" : actionableBearPoi ? "S:A" : "S:D") : poiContextText
        string compactBarrier = bias == 1 ? (na(bullPoiBarrier) ? "Open above" : "OH " + str.tostring(bullPoiBarrier, format.mintick)) : bias == -1 ? (na(bearPoiBarrier) ? "Open below" : "SUP " + str.tostring(bearPoiBarrier, format.mintick)) : "Bias pending"
        string barrierLiquidityText = (compactPanel ? compactBarrier : opposingBarrierText) + " · LQ " + str.tostring(relevantLiquidityCount) + "/" + str.tostring(poolActiveCount)

        // Compact = major information only: bias and phase, where price sits in the range
        // (premium / discount), swing levels, last structure event, nearest POIs, nearest
        // liquidity, Asian range and a one-line zone summary. Hover cells for detail.
        float rangePct = not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh > lastSwingLow ? (close - lastSwingLow) / (lastSwingHigh - lastSwingLow) * 100.0 : na
        bool inRange = rangeText == "Premium" or rangeText == "Discount"
        string rangeCompact = na(rangePct) ? "Range pending" : rangeText + (inRange ? " " + str.tostring(rangePct, "0") + "%" : "") + " · EQ " + str.tostring(majorMid, format.mintick)
        color rangeTone = rangeText == "Premium" or rangeText == "Above range" ? supplyColor : rangeText == "Discount" or rangeText == "Below range" ? demandColor : color.silver
        string breakAge = na(lastBreakTime) ? "" : " · " + f_age(lastBreakTime)
        string internalCompact = na(lastInternalBreakTime) ? "none" : lastInternalBreak + " · " + f_age(lastInternalBreakTime)
        bool liveAsia = not na(asiaLiveHigh) and not na(asiaLiveLow)
        string asiaCompact = liveAsia ? "Live " + str.tostring(asiaLiveHigh, format.mintick) + " / " + str.tostring(asiaLiveLow, format.mintick) : asiaHighText + " / " + asiaLowText
        string zonesCompact = "OB " + str.tostring(visibleOB) + "/" + str.tostring(activeOB) + " · S/D " + str.tostring(visibleSD) + "/" + str.tostring(activeSD) + " · FVG " + str.tostring(visibleFVG) + "/" + str.tostring(activeFVG)
        string swingTip = "High " + highText + (na(lastHighTime) ? "" : " · " + str.format_time(lastHighTime, "MM-dd HH:mm", syminfo.timezone)) + "\nLow " + lowText + (na(lastLowTime) ? "" : " · " + str.format_time(lastLowTime, "MM-dd HH:mm", syminfo.timezone)) + "\nDeveloping extreme " + developingText + "\nLast confirmed external swings (chart time zone)."
        int closedTrades = array.size(tradeResults)
        int tradeWins = 0
        if closedTrades > 0
            for t = 0 to closedTrades - 1
                tradeWins += array.get(tradeResults, t) > 0 ? 1 : 0
        float tradeProfitFactor = tradeGrossLossR > 0 ? tradeGrossWinR / tradeGrossLossR : na
        float openRR = tradeDir != 0 ? math.abs(tradeTarget - tradeEntry) / math.max(math.abs(tradeEntry - tradeStop), syminfo.mintick) : na
        string tradeSummary = tradeDir != 0 ? (tradeDir == 1 ? "LONG" : "SHORT") + " open · " + str.tostring(openRR, "0.0") + "R → " + tradeTargetName : not showTradePlan ? "Off" : closedTrades == 0 ? "No trades yet" : str.tostring(closedTrades) + " · " + str.tostring(tradeWins * 100.0 / closedTrades, "0") + "% · " + f_tradeResultText(tradeEquityR)
        string tradeTip = "Paper results of the trade plan on closed bars of the loaded history. No orders are sent; this is not a performance claim.\n" + "Closed " + str.tostring(closedTrades) + " · target " + str.tostring(array.get(tradeStats, 1)) + " · stop " + str.tostring(array.get(tradeStats, 2)) + " · timeout " + str.tostring(array.get(tradeStats, 3)) + "\n" + "Total " + f_tradeResultText(tradeEquityR) + " · profit factor " + (na(tradeProfitFactor) ? "n/a" : str.tostring(tradeProfitFactor, "0.00")) + " · max drawdown " + str.tostring(tradeMaxDrawdownR, "0.0") + "R\n" + "Skipped: no key-level target " + str.tostring(array.get(tradeStats, 4)) + " · stop outside limits " + str.tostring(array.get(tradeStats, 5))
        if array.size(tradeLog) > 0
            for t = array.size(tradeLog) - 1 to math.max(0, array.size(tradeLog) - 8)
                tradeTip += "\n" + array.get(tradeLog, t)
        if compactPanel
            table.cell(dashboard, 0, 0, "APEXVOID v2.9", width = dashboardKeyWidth, height = dashboardRowHeight * 1.35, text_color = #F3EAFF, text_size = dashboardTitleSize, text_halign = text.align_left, bgcolor = color.new(#493178, 8))
            table.cell(dashboard, 1, 0, syminfo.ticker + " · " + timeframe.period, width = dashboardValueWidth, height = dashboardRowHeight * 1.35, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, bgcolor = color.new(#493178, 8))
            table.cell(dashboard, 0, 2, "Bias", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 2, biasText + htfBiasSuffix, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "Directional leg: " + legText)
            table.cell(dashboard, 0, 3, "Phase", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 3, phaseText, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "Directional leg: " + legText)
            table.cell(dashboard, 0, 4, "Range", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 4, rangeCompact, text_color = rangeTone, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "Position of the close inside the last confirmed external range. Premium (upper half) is the supply side, discount (lower half) the demand side; EQ is the 50% level.")
            table.cell(dashboard, 0, 6, "High / Low", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 6, highText + " / " + lowText, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = swingTip)
            table.cell(dashboard, 0, 9, "Protected", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 9, protectedText, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "The external level whose break flips the bias.")
            table.cell(dashboard, 0, 10, "Last break", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 10, lastBreak + breakAge, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "Last external BOS / CHoCH." + (na(lastBreakTime) ? "" : " At " + str.format_time(lastBreakTime, "MM-dd HH:mm", syminfo.timezone)) + "\nLast internal break: " + internalCompact)
            table.cell(dashboard, 0, 13, "Bull POI", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 13, bullPoiDisplay, text_color = bullColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = nearestBullPoiText + "\nA actionable · Q qualified · D distant or tested")
            table.cell(dashboard, 0, 14, "Bear POI", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 14, bearPoiDisplay, text_color = bearColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = nearestBearPoiText + "\nA actionable · Q qualified · D distant or tested")
            table.cell(dashboard, 0, 16, "BSL / SSL", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 16, liqRowText, text_color = liquidityColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = liquidityText + "\n" + barrierLiquidityText)
            table.cell(dashboard, 0, 18, "Asia", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 18, asiaCompact, text_color = asiaColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = (liveAsia ? "Session in progress. " : "Last completed session. ") + "Completed: " + asiaHighText + " / " + asiaLowText)
            table.cell(dashboard, 0, 22, "Zones", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 0, 27, "Trades", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 27, tradeSummary, text_color = tradeDir == 1 ? bullColor : tradeDir == -1 ? bearColor : color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = tradeTip)
            table.cell(dashboard, 1, 22, zonesCompact, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "Visible / active\n" + zoneText + "\nOrder blocks: " + obSummary + "\nSupply / demand: " + sdSummary + "\n" + obTooltip + "\n" + sdTooltip)
        else
            table.cell(dashboard, 0, 0, "APEXVOID v2.9", width = dashboardKeyWidth, height = dashboardRowHeight * 1.35, text_color = #F3EAFF, text_size = dashboardTitleSize, text_halign = text.align_left, bgcolor = color.new(#493178, 8))
            table.cell(dashboard, 1, 0, syminfo.ticker + " · " + timeframe.period, width = dashboardValueWidth, height = dashboardRowHeight * 1.35, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, bgcolor = color.new(#493178, 8))
            table.cell(dashboard, 0, 1, "MARKET STATE", height = dashboardRowHeight, text_color = #CDB5FF, text_size = dashboardSectionSize, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
            table.cell(dashboard, 0, 2, "External Bias", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 2, biasText + htfBiasSuffix, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 3, "Market Phase", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 3, phaseText, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 4, "Directional Leg", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 4, legText, text_color = developingDirection == 1 ? bullColor : developingDirection == -1 ? bearColor : color.silver, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 5, "STRUCTURE", height = dashboardRowHeight, text_color = #CDB5FF, text_size = dashboardSectionSize, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
            table.cell(dashboard, 0, 6, compactPanel ? "Confirmed H / L" : "Confirmed Major High", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            string swingWhen = "High " + highText + (na(lastHighTime) ? "" : " · " + str.format_time(lastHighTime, "MM-dd HH:mm", syminfo.timezone)) + "\nLow " + lowText + (na(lastLowTime) ? "" : " · " + str.format_time(lastLowTime, "MM-dd HH:mm", syminfo.timezone)) + "\nLast confirmed external swings (chart time zone). A newer lower high or higher low is not listed until it is confirmed by a displaced leg."
            table.cell(dashboard, 1, 6, compactPanel ? highText + " / " + lowText : highText, text_color = compactPanel ? color.white : bearColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = swingWhen)
            if not compactPanel
                table.cell(dashboard, 0, 7, "Confirmed Major Low", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
                table.cell(dashboard, 1, 7, lowText, text_color = bullColor, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 8, "Developing Extreme", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 8, developingText, text_color = developingDirection == 1 ? bullColor : bearColor, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 9, "Protected Level", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 9, protectedText, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 10, "Last BOS / CHoCH", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            string lastBreakAge = na(lastBreakTime) ? "" : " · " + f_age(lastBreakTime)
            string lastBreakWhen = na(lastBreakTime) ? "No external break yet" : "External break at " + str.format_time(lastBreakTime, "MM-dd HH:mm", syminfo.timezone) + " (chart time zone). External structure only: lower lows that were never confirmed as swings do not create a new BOS. See the internal break below."
            table.cell(dashboard, 1, 10, lastBreak + lastBreakAge, text_color = valueColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = lastBreakWhen)
            string internalAge = na(lastInternalBreakTime) ? "" : " · " + f_age(lastInternalBreakTime)
            color internalTone = str.startswith(lastInternalBreak, "Bull") ? bullColor : str.startswith(lastInternalBreak, "Bear") ? bearColor : color.silver
            table.cell(dashboard, 0, 11, "Last Internal Break", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 11, lastInternalBreak + internalAge, text_color = internalTone, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = na(lastInternalBreakTime) ? "No internal break yet" : "Internal break at " + str.format_time(lastInternalBreakTime, "MM-dd HH:mm", syminfo.timezone) + " (chart time zone). Internal structure never changes the external bias.")
            if expandedPanel
                table.cell(dashboard, 0, 25, "Invalidated Level", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
                table.cell(dashboard, 1, 25, invalidatedText, text_color = color.new(color.silver, 18), text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 12, "PRICE ACTION", height = dashboardRowHeight, text_color = #CDB5FF, text_size = dashboardSectionSize, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
            table.cell(dashboard, 0, 13, "Nearest Bullish POI", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 13, bullPoiDisplay, text_color = bullColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = nearestBullPoiText)
            table.cell(dashboard, 0, 14, "Nearest Bearish POI", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 14, bearPoiDisplay, text_color = bearColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = nearestBearPoiText)
            table.cell(dashboard, 0, 15, "POI Status", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 15, poiStatusDisplay == "" ? "No qualified POI" : poiStatusDisplay, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = poiContextText + "\n" + zoneText + "\nA = actionable; D = distant, tested, or wrong side of price")
            table.cell(dashboard, 0, 16, "Barrier / Liquidity", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 16, barrierLiquidityText, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = liquidityText)
            table.cell(dashboard, 0, 17, "SESSION", height = dashboardRowHeight, text_color = #CDB5FF, text_size = dashboardSectionSize, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
            string asiaDate = na(asiaStart) ? "" : " " + str.format_time(asiaStart, "MM-dd", asiaTZ)
            string asiaNote = na(asiaStart) ? "No completed Asian session yet" : "Last COMPLETED session started " + str.format_time(asiaStart, "MM-dd HH:mm", asiaTZ) + " (" + asiaTZ + "). The session in progress is on the live row."
            bool asiaLiveActive = not na(asiaLiveHigh) and not na(asiaLiveLow)
            table.cell(dashboard, 0, 18, compactPanel ? "Asian H / L" + asiaDate : "Asian High" + asiaDate, height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 18, compactPanel ? asiaHighText + " / " + asiaLowText : asiaHighText, text_color = asiaColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = asiaNote)
            table.cell(dashboard, 0, 20, "Asian Live H / L", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 20, asiaLiveActive ? str.tostring(asiaLiveHigh, format.mintick) + " / " + str.tostring(asiaLiveLow, format.mintick) : "Session closed", text_color = asiaLiveActive ? asiaColor : color.new(color.silver, 30), text_size = dashboardValueSize, text_halign = text.align_right, tooltip = "Range of the Asian session in progress so far; it becomes the completed range above when the session ends.")
            if not compactPanel
                table.cell(dashboard, 0, 19, "Asian Low", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
                table.cell(dashboard, 1, 19, asiaLowText, text_color = asiaColor, text_size = dashboardValueSize, text_halign = text.align_right)
            table.cell(dashboard, 0, 21, "BLOCKS & LIQUIDITY", height = dashboardRowHeight, text_color = #CDB5FF, text_size = dashboardSectionSize, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
            table.cell(dashboard, 0, 22, "Order Blocks", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 22, obSummary, text_color = activeOB == 0 ? color.new(color.silver, 18) : color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = obTooltip)
            table.cell(dashboard, 0, 23, "Nearest BSL / SSL", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 23, liqRowText, text_color = liquidityColor, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = liquidityText)
            table.cell(dashboard, 0, 27, "Trades", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 27, tradeSummary, text_color = tradeDir == 1 ? bullColor : tradeDir == -1 ? bearColor : color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = tradeTip)
            table.cell(dashboard, 0, 24, "Supply / Demand", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
            table.cell(dashboard, 1, 24, sdSummary, text_color = color.white, text_size = dashboardValueSize, text_halign = text.align_right, tooltip = sdTooltip)
            if expandedPanel
                table.cell(dashboard, 0, 26, "Zone Audit", height = dashboardRowHeight, text_color = color.silver, text_size = dashboardValueSize, text_halign = text.align_left)
                table.cell(dashboard, 1, 26, auditShort, text_color = color.new(color.white, 12), text_size = dashboardValueSize, text_halign = text.align_right, tooltip = auditText)
    0

if barstate.islast
    f_renderPanel()

// ------- OB DEBUG VIEW (TEMPORARY, OFF BY DEFAULT) -------
// Lists every active block with its lifecycle state and visibility reason, then the
// most recent candidate evaluations (accepted and rejected) with the exact reason.
var table obDebugTable = table.new(position.bottom_left, 1, 30, bgcolor = color.new(#090D18, 6), frame_color = color.new(bullColor, 45), frame_width = 1, border_width = 0)
f_renderObDebug() =>
    table.clear(obDebugTable, 0, 0, 0, 29)
    if showOBDebug
        table.cell(obDebugTable, 0, 0, "OB DEBUG · active " + str.tostring(activeOB) + " (visible " + str.tostring(visibleBullOB + visibleBearOB) + ") · far " + str.tostring(hiddenOBFar) + " · overlap " + str.tostring(hiddenOBOverlap) + " · budget " + str.tostring(hiddenOBBudget), text_color = color.white, text_size = size.tiny, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
        int debugRow = 1
        if array.size(obDebugRows) > 0
            for r = 0 to math.min(array.size(obDebugRows), 8) - 1
                table.cell(obDebugTable, 0, debugRow, array.get(obDebugRows, r), text_color = color.silver, text_size = size.tiny, text_halign = text.align_left)
                debugRow += 1
        table.cell(obDebugTable, 0, debugRow, "RECENT CANDIDATES", text_color = #CDB5FF, text_size = size.tiny, text_halign = text.align_left, bgcolor = color.new(#231B38, 10))
        debugRow += 1
        if array.size(obDebugLog) > 0
            for r = array.size(obDebugLog) - 1 to math.max(0, array.size(obDebugLog) - 14)
                table.cell(obDebugTable, 0, debugRow, array.get(obDebugLog, r), text_color = str.contains(array.get(obDebugLog, r), "ACCEPT") ? bullColor : str.contains(array.get(obDebugLog, r), "REJECT") ? color.new(bearColor, 10) : color.silver, text_size = size.tiny, text_halign = text.align_left)
                debugRow += 1
    0

if barstate.islast
    f_renderObDebug()

// ------- BAR-CLOSE ALERT EVENTS (EXTERNAL STRUCTURE, CONFIRMED ONLY) -------
// BOS/CHoCH alerts now refer to confirmed external swings; internal breaks are
// visual-only unless the internal display is enabled.
alertcondition(upBOS, "ApexVoid Bullish BOS", "Bullish BOS on {{ticker}} ({{interval}})")
alertcondition(downBOS, "ApexVoid Bearish BOS", "Bearish BOS on {{ticker}} ({{interval}})")
alertcondition(upCHOCH, "ApexVoid Bullish CHOCH", "Bullish CHOCH on {{ticker}} ({{interval}})")
alertcondition(downCHOCH, "ApexVoid Bearish CHOCH", "Bearish CHOCH on {{ticker}} ({{interval}})")
alertcondition(bslSweep, "ApexVoid Buy-Side Sweep", "Buy-side liquidity sweep (potential bearish rejection) on {{ticker}} ({{interval}})")
alertcondition(sslSweep, "ApexVoid Sell-Side Sweep", "Sell-side liquidity sweep (potential bullish rejection) on {{ticker}} ({{interval}})")
alertcondition(externalBslSweep, "ApexVoid External Buy-Side Sweep", "External buy-side liquidity sweep on {{ticker}} ({{interval}})")
alertcondition(externalSslSweep, "ApexVoid External Sell-Side Sweep", "External sell-side liquidity sweep on {{ticker}} ({{interval}})")
alertcondition(bslTaken, "ApexVoid Buy-Side Liquidity Consumed", "Buy-side liquidity pool consumed (close-confirmed acceptance or structural break) on {{ticker}} ({{interval}})")
alertcondition(sslTaken, "ApexVoid Sell-Side Liquidity Consumed", "Sell-side liquidity pool consumed (close-confirmed acceptance or structural break) on {{ticker}} ({{interval}})")
alertcondition(tradeLongOpened, "ApexVoid Trade Plan Long", "Long setup (price-action trigger at a qualified POI) on {{ticker}} ({{interval}})")
alertcondition(tradeShortOpened, "ApexVoid Trade Plan Short", "Short setup (price-action trigger at a qualified POI) on {{ticker}} ({{interval}})")
alertcondition(tradeTargetHit, "ApexVoid Trade Plan Target Hit", "Trade plan target reached on {{ticker}} ({{interval}})")
alertcondition(tradeStopHit, "ApexVoid Trade Plan Stop Hit", "Trade plan stop hit on {{ticker}} ({{interval}})")
alertcondition(bullFVG, "ApexVoid Bullish FVG", "New bullish FVG on {{ticker}} ({{interval}})")
alertcondition(bearFVG, "ApexVoid Bearish FVG", "New bearish FVG on {{ticker}} ({{interval}})")
alertcondition(bullBase, "ApexVoid Demand Base Zone", "New base-and-impulse demand zone on {{ticker}} ({{interval}})")
alertcondition(bearBase, "ApexVoid Supply Base Zone", "New base-and-impulse supply zone on {{ticker}} ({{interval}})")
alertcondition(bullOB, "ApexVoid Bullish OB", "New qualified bullish order block on {{ticker}} ({{interval}})")
alertcondition(bearOB, "ApexVoid Bearish OB", "New qualified bearish order block on {{ticker}} ({{interval}})")
alertcondition(newAsianRange and showAsia, "ApexVoid Asian Range Complete", "A new Asian session H/L range completed on {{ticker}} ({{interval}})")
