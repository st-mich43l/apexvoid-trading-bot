color bearFvgColor = input.color(#FFA957, "Bearish FVG color", group = G6)
color demandColor = input.color(#36D399, "Demand color", group = G6)
color supplyColor = input.color(#FF7892, "Supply color", group = G6)
color asiaColor = input.color(#B48AFF, "Asian levels color", group = G6)
color liquidityColor = input.color(#AEB8CC, "Liquidity pool color", group = G6)
bool showPremiumDiscount = input.bool(true, "Show premium / discount range (equilibrium)", group = G6)
bool protectCandleScale = input.bool(true, "Keep candles readable: limit objects to a window around price", group = G6)
int scaleLookbackBars = input.int(300, "Candle range reference (bars)", minval = 50, maxval = 780, group = G6)
bool showNearestInternal = input.bool(true, "Show nearest unswept internal swing high / low (iBSL / iSSL)", group = G2)
float scaleWindowATR = input.float(15.0, "Candle-scale window (ATR)", minval = 3, maxval = 60, step = 0.5, group = G6)
