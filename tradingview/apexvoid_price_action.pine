bool showSD = input.bool(true, "Show swing supply / demand", group = G3)
bool showBaseSD = input.bool(true, "Show base-and-impulse supply / demand", group = G3)
string sdPatternFilter = input.string("All", "Base-and-impulse patterns", options = ["All", "Reversal only", "Continuation only"], group = G3)
int sdBaseMaxBars = input.int(5, "Base maximum candles", minval = 1, maxval = 10, group = G3)
float sdBaseBarRangeATR = input.float(0.90, "Base candle maximum range (ATR)", minval = 0.1, maxval = 3, step = 0.05, group = G3)
float sdBaseBodyATR = input.float(0.45, "Base candle maximum body (ATR)", minval = 0.05, maxval = 2, step = 0.05, group = G3)
float sdBaseDepartATR = input.float(1.50, "Minimum departure from base (ATR)", minval = 0.2, maxval = 8, step = 0.1, group = G3)
float sdDepartRatio = input.float(2.00, "Minimum departure vs base height (x)", minval = 0.5, maxval = 10, step = 0.25, group = G3)
float sdImpulseBodyATR = input.float(0.80, "Minimum departure candle body (ATR)", minval = 0.1, maxval = 4, step = 0.05, group = G3)
int sdDepartBars = input.int(3, "Departure window (bars)", minval = 1, maxval = 6, group = G3)
int sdLegInBars = input.int(3, "Leg-in lookback for pattern type (bars)", minval = 1, maxval = 10, group = G3)
