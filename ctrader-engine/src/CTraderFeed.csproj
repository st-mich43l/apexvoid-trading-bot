<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ctrader-feed</AssemblyName>
    <RootNamespace>ApexVoid.CTraderFeed</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native AOT already emits one native executable; PublishSingleFile is
         mutually exclusive with PublishAot. The Docker non-AOT fallback
         explicitly overrides this back to true. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- Load-bearing, not stylistic — ADR-010 (docs/adr/010-dotnet-kafka-client.md):
         Dekaf (the Kafka client) hangs at runtime under the AOT-implied
         default TrimMode=full; `partial` is the real, evidence-backed fix,
         still fully self-contained/trimmed/AOT. Removing this line
         silently reintroduces that hang. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.OpenAPI.Net" Version="1.4.4" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.11" />
    <!-- ADR-010: Dekaf, not Confluent.Kafka — real, documented Native
         AOT incompatibility evidence for the latter. Pure managed C#,
         no native library bundled. -->
    <PackageReference Include="Dekaf" Version="1.14.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CTraderFeed.Tests" />
  </ItemGroup>
</Project>
