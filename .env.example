# Secrets and process bootstrap only. Every non-secret behavior belongs in
# config/*.yml (see docs/configuration.md).

# --- Bootstrap ---
# Root configuration file; config/apexvoid.demo.yml for a development deployment.
APEXVOID_CONFIG_FILE=/config/apexvoid.yml
# LOG_LEVEL=INFO
# LOG_FILE_ENABLED=true
# LOG_RETENTION_DAYS=14

# --- Database ---
POSTGRES_PASSWORD=<required-secret>
DATABASE_URL=<required-secret>

# --- Telegram ---
TELEGRAM_BOT_TOKEN=<required-secret>
TELEGRAM_OWNER_ID=<required-identifier>
SIGNAL_VIP_CHANNEL_ID=<required-identifier>
SIGNAL_PUBLIC_CHANNEL_ID=<optional-identifier>
SCANNER_TELEGRAM_BOT_TOKEN=<optional-secret>

# --- cTrader ---
CTRADER_CLIENT_ID=<required-identifier>
CTRADER_CLIENT_SECRET=<required-secret>
CTRADER_ACCESS_TOKEN=<required-secret>
CTRADER_REFRESH_TOKEN=<required-secret>
CTRADER_ACCOUNT_ID=<required-identifier>

# --- Optional integrations ---
# ANTHROPIC_API_KEY=<secret>
# TIINGO_API_KEY=<secret>
