# Generated minimal environment template. Do not edit manually.
# Regenerate with: python -m app.configuration.generate --write
# Full contract: docs/configuration/environment-reference.generated.md
# Secrets use typed placeholders; never commit real secret values.

# --- Deployment ---
# V3 root configuration file (see docs/configuration.md). Point at config/apexvoid.demo-eval.yml for a demo_eval deployment instead.
APEXVOID_CONFIG_FILE=/config/apexvoid.yml
# Postgres password (compose-managed database credential).
POSTGRES_PASSWORD=<required-secret>

# --- Configuration (catalog-backed) ---
# bootstrap.telegram.bot_token [str] (secret)
TELEGRAM_BOT_TOKEN=<required-secret>
# bootstrap.postgres.url [str] (secret)
DATABASE_URL=<required-secret>
# bootstrap.ctrader.credentials.client_id [string]
CTRADER_CLIENT_ID=<required-identifier>
# bootstrap.ctrader.credentials.client_secret [string] (secret)
CTRADER_CLIENT_SECRET=<required-secret>
# bootstrap.ctrader.credentials.access_token [string] (secret)
CTRADER_ACCESS_TOKEN=<required-secret>
# bootstrap.ctrader.credentials.refresh_token [string] (secret)
CTRADER_REFRESH_TOKEN=<required-secret>
# bootstrap.ctrader.credentials.account_id [long]
CTRADER_ACCOUNT_ID=<required-identifier>

# Optional knobs: see docs/configuration/environment-reference.generated.md
