{# Rendered on the VPS by ansible (deploy_image role). Do not edit on the host. #}
{# Vars: image_tag, registry_namespace, apexvoid_trading_bot_secrets (vault).     #}
{# Non-secret tuning lives in config/trading-bot.yml (CONFIG_FILE).               #}
{# Secrets + shared cTrader ENV live in secrets/trading-bot.env (env_file).        #}
{# DATABASE_URL host must be "postgres"; REDIS_URL host should be "redis".         #}
name: apexvoid-trading-bot

services:
  postgres:
    image: postgres:17-alpine
    container_name: apexvoid-trading-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ apexvoid_trading_bot_secrets.POSTGRES_USER | to_json }}
      POSTGRES_PASSWORD: {{ apexvoid_trading_bot_secrets.POSTGRES_PASSWORD | to_json }}
      POSTGRES_DB: {{ apexvoid_trading_bot_secrets.POSTGRES_DB | to_json }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ apexvoid_trading_bot_secrets.POSTGRES_USER }} -d {{ apexvoid_trading_bot_secrets.POSTGRES_DB }}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s

  redis:
    image: redis:7-alpine
    container_name: apexvoid-trading-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s

  kafka:
    image: apache/kafka:4.0.0
    container_name: apexvoid-kafka
    restart: unless-stopped
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "false"
      CLUSTER_ID: 4L6g3nShT-eMCtK--X86sw
    volumes:
      - kafkadata:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 >/dev/null 2>&1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s

  kafka-init:
    image: "{{ registry_namespace }}/apexvoid-analysis-engine:{{ image_tag }}"
    container_name: apexvoid-kafka-init
    restart: "no"
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
    entrypoint: ["/app/kafka-admin"]
    depends_on:
      kafka:
        condition: service_healthy
    volumes:
      - ./config:/config:ro

  analysis-engine:
    image: "{{ registry_namespace }}/apexvoid-analysis-engine:{{ image_tag }}"
    container_name: apexvoid-analysis-engine
    restart: unless-stopped
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
    depends_on:
      redis:
        condition: service_healthy
      kafka:
        condition: service_healthy
      kafka-init:
        condition: service_completed_successfully
    volumes:
      - ./config:/config:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health/ready"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s

  # Startup order:
  #   postgres + redis → config-compiler → ctrader-engine → bot
  # ResolvedRuntimeManifest V2 is authoritative. ENV is secrets + bootstrap only.
  config-compiler:
    image: "{{ registry_namespace }}/apexvoid-trading-bot:{{ image_tag }}"
    container_name: apexvoid-config-compiler
    restart: "no"
    env_file:
      - ./secrets/trading-bot.env
    environment:
      APEXVOID_CONFIG_FILE: /config/trading-bot.yml
      APEXVOID_RUNTIME_MANIFEST_FILE: /runtime/resolved-runtime.json
    command:
      - python
      - -m
      - app.configuration.runtime_manifest_cli
      - --config-file
      - /config/trading-bot.yml
      - --output
      - /runtime/resolved-runtime.json
      - --check
    volumes:
      - ./config/trading-bot.yml:/config/trading-bot.yml:ro
      - runtime-config:/runtime

  ctrader-engine:
    image: "{{ registry_namespace }}/apexvoid-ctrader-engine:{{ image_tag }}"
    container_name: apexvoid-ctrader-engine
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
      config-compiler:
        condition: service_completed_successfully
    env_file:
      - ./secrets/trading-bot.env
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
      # ResolvedRuntimeManifest V2 is authoritative.
      # ENV contains secrets and bootstrap only.
      # See docs/configuration/manifest-authority-cutover.md.
      APEXVOID_RUNTIME_MANIFEST_FILE: /runtime/resolved-runtime.json
      CTRADER_CONFIGURATION_SOURCE: manifest
      CTRADER_MANIFEST_PARITY_MODE: off
    volumes:
      - ./config:/config:ro
      - ./data/ctrader-token:/var/lib/apexvoid
      - ./logs/ctrader-engine:/var/log/apexvoid
      - runtime-config:/runtime:ro
    healthcheck:
      test: ["CMD", "/app/ctrader-feed", "--healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 8
      # Broker connect + historical backfill write the first heartbeat.
      start_period: 120s

  bot:
    image: "{{ registry_namespace }}/apexvoid-trading-bot:{{ image_tag }}"
    container_name: apexvoid-trading-bot
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      config-compiler:
        condition: service_completed_successfully
      ctrader-engine:
        condition: service_healthy
    env_file:
      - ./secrets/trading-bot.env
    environment:
      APEXVOID_CONFIG_FILE: /config/trading-bot.yml
      APEXVOID_RUNTIME_MANIFEST_FILE: /runtime/resolved-runtime.json
    volumes:
      - ./config/trading-bot.yml:/config/trading-bot.yml:ro
      - runtime-config:/runtime:ro
      - ./data:/data
      - ./logs/algo-bot:/var/log/apexvoid

volumes:
  pgdata:
  redisdata:
  runtime-config:
  kafkadata:
