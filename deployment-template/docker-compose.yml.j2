{# Rendered on the VPS by ansible (deploy_image role). Do not edit on the host. #}
{# Vars: image_tag, registry_namespace, apexvoid_trading_bot_secrets (vault).     #}
{# Non-secret tuning lives in config/apexvoid.yml (CONFIG_FILE).                 #}
{# Secrets + shared cTrader ENV live in secrets/trading-bot.env (env_file).        #}
{# DATABASE_URL host must be "postgres"; REDIS_URL host should be "redis".         #}
name: apexvoid-trading-bot

services:
  postgres:
    image: postgres:17-alpine
    container_name: apexvoid-trading-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ apexvoid_trading_bot_secrets.POSTGRES_USER | to_json }}
      POSTGRES_PASSWORD: {{ apexvoid_trading_bot_secrets.POSTGRES_PASSWORD | to_json }}
      POSTGRES_DB: {{ apexvoid_trading_bot_secrets.POSTGRES_DB | to_json }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ apexvoid_trading_bot_secrets.POSTGRES_USER }} -d {{ apexvoid_trading_bot_secrets.POSTGRES_DB }}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s

  redis:
    image: redis:7-alpine
    container_name: apexvoid-trading-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s

  kafka:
    image: apache/kafka:4.0.0
    container_name: apexvoid-kafka
    restart: unless-stopped
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "false"
      # The image's own default log dir is under /tmp, i.e. the container layer: without this
      # every recreate silently wiped topics and consumer offsets while kafkadata stayed empty.
      KAFKA_LOG_DIRS: /var/lib/kafka/data
      CLUSTER_ID: 4L6g3nShT-eMCtK--X86sw
    volumes:
      - kafkadata:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 >/dev/null 2>&1"]
      # The probe starts a JVM per run; on the shared 6-vCPU host that takes
      # longer than 5s whenever the box is busy, which left the broker
      # "unhealthy" for hours and made `compose up` refuse to start the
      # analysis engine on the 2026-10-01 deploy (broker was serving fine).
      interval: 30s
      timeout: 25s
      retries: 6
      start_period: 60s

  kafka-init:
    image: "{{ registry_namespace }}/apexvoid-analysis-engine:{{ image_tag }}"
    container_name: apexvoid-kafka-init
    restart: "no"
    user: apexvoid
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
    entrypoint: ["/app/kafka-admin"]
    depends_on:
      kafka:
        condition: service_healthy
    volumes:
      - ./config:/config:ro

  analysis-engine:
    image: "{{ registry_namespace }}/apexvoid-analysis-engine:{{ image_tag }}"
    container_name: apexvoid-analysis-engine
    restart: unless-stopped
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
      # Keep shared retention/enable/level policy aligned with Ansible's
      # bootstrap ENV; the file name remains service-specific.
      LOG_LEVEL: {{ (apexvoid_trading_bot_bootstrap_env | default({})).LOG_LEVEL | default("INFO") | to_json }}
      LOG_DIR: {{ (apexvoid_trading_bot_bootstrap_env | default({})).LOG_DIR | default("/var/log/apexvoid") | to_json }}
      LOG_RETENTION_DAYS: {{ (apexvoid_trading_bot_bootstrap_env | default({})).LOG_RETENTION_DAYS | default("14") | to_json }}
      LOG_FILE_ENABLED: {{ (apexvoid_trading_bot_bootstrap_env | default({})).LOG_FILE_ENABLED | default("true") | to_json }}
      LOG_FILE_NAME: analysis-engine.log
    depends_on:
      redis:
        condition: service_healthy
      kafka:
        condition: service_healthy
      kafka-init:
        condition: service_completed_successfully
    volumes:
      - ./config:/config:ro
      # runtime.kafka.outbox_path lives here: the publication ledger must outlive a recreate.
      - analysis-engine-state:/var/lib/apexvoid-analysis-engine
      - ./logs/analysis-engine:/var/log/apexvoid
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health/ready"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s

  ctrader-engine:
    image: "{{ registry_namespace }}/apexvoid-ctrader-engine:{{ image_tag }}"
    container_name: apexvoid-ctrader-engine
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
    env_file:
      - ./secrets/trading-bot.env
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
    volumes:
      - ./config:/config:ro
      - ./data/ctrader-token:/var/lib/apexvoid
      - ./logs/ctrader-engine:/var/log/apexvoid
    healthcheck:
      test: ["CMD", "/app/ctrader-feed", "--healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 8
      # Broker connect + historical backfill write the first heartbeat.
      start_period: 120s

  bot:
    image: "{{ registry_namespace }}/apexvoid-trading-bot:{{ image_tag }}"
    container_name: apexvoid-trading-bot
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      ctrader-engine:
        condition: service_healthy
    env_file:
      - ./secrets/trading-bot.env
    environment:
      APEXVOID_CONFIG_FILE: /config/apexvoid.yml
    volumes:
      - ./config:/config:ro
      - ./data:/data
      - ./logs/algo-bot:/var/log/apexvoid

volumes:
  pgdata:
  redisdata:
  kafkadata:
  analysis-engine-state:
