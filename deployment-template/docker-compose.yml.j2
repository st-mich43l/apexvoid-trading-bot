{# Rendered on the VPS by ansible (deploy_image role). Do not edit on the host. #}
{# Vars: image_tag, registry_namespace, apexvoid_trading_bot_secrets (vault).     #}
{# Non-secret tuning lives in config/trading-bot.yml (CONFIG_FILE).               #}
{# Secrets + shared cTrader ENV live in secrets/trading-bot.env (env_file).        #}
{# DATABASE_URL host must be "postgres"; REDIS_URL host should be "redis".         #}
name: apexvoid-trading-bot

services:
  postgres:
    image: postgres:17-alpine
    container_name: apexvoid-trading-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ apexvoid_trading_bot_secrets.POSTGRES_USER | to_json }}
      POSTGRES_PASSWORD: {{ apexvoid_trading_bot_secrets.POSTGRES_PASSWORD | to_json }}
      POSTGRES_DB: {{ apexvoid_trading_bot_secrets.POSTGRES_DB | to_json }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ apexvoid_trading_bot_secrets.POSTGRES_USER }} -d {{ apexvoid_trading_bot_secrets.POSTGRES_DB }}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s

  redis:
    image: redis:7-alpine
    container_name: apexvoid-trading-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s

  # Startup order (Compose waits on health, not just process start):
  #   postgres + redis → ctrader-engine → bot
  ctrader-engine:
    image: "{{ registry_namespace }}/apexvoid-ctrader-engine:{{ image_tag }}"
    container_name: apexvoid-ctrader-engine
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
    env_file:
      - ./secrets/trading-bot.env
    volumes:
      - ./data/ctrader-token:/var/lib/apexvoid
      - ./logs/ctrader-engine:/var/log/apexvoid
    healthcheck:
      test: ["CMD", "/app/ctrader-feed", "--healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 8
      # Broker connect + historical backfill write the first heartbeat.
      start_period: 120s

  bot:
    image: "{{ registry_namespace }}/apexvoid-trading-bot:{{ image_tag }}"
    container_name: apexvoid-trading-bot
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      ctrader-engine:
        condition: service_healthy
    env_file:
      - ./secrets/trading-bot.env
    environment:
      APEXVOID_CONFIG_FILE: /config/trading-bot.yml
    volumes:
      - ./config/trading-bot.yml:/config/trading-bot.yml:ro
      - ./data:/data
      - ./logs/algo-bot:/var/log/apexvoid

volumes:
  pgdata:
  redisdata:
